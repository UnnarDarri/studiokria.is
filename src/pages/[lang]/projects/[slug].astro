---
/**
 * Project Detail Page - Portrait hero with stills lightbox
 * Desktop: 4:5 hero with overlay content on image
 * Mobile: 4:5 crop image stacked, content below
 */
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import { t, getTranslation } from '../../../i18n';
import Lightbox from '../../../components/Lightbox.astro';
import VideoLightbox from '../../../components/VideoLightbox.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  const paths = [];
  for (const project of projects) {
    for (const lang of ['en', 'is']) {
      paths.push({
        params: { lang, slug: project.id },
        props: { project, locale: lang },
      });
    }
  }
  return paths;
}

const { project, locale } = Astro.props;
const { data, body } = project;
const slug = project.id;

const translations = getTranslation(locale);
const basePath = import.meta.env.BASE_URL || '/';
const assetUrl = (path: string) => `${basePath.replace(/\/$/, '')}${path.startsWith('/') ? path : '/' + path}`;
const localUrl = (path: string) => `${basePath.replace(/\/$/, '')}/${locale}${path.startsWith('/') ? path : '/' + path}`;
const pathname = `/projects/${slug}/`;

const typeLabels = translations.projectTypes;
const statusLabels = translations.projectStatus;
const statusColors: Record<string, string> = {
  'completed': 'var(--accent)',
  'in-production': '#e67e22',
  'pre-production': '#3498db',
  'development': '#9b59b6',
};

// Fetch all projects for navigation
const allProjects = await getCollection('projects');
const sortedProjects = [...allProjects].sort((a, b) => {
  if (a.data.featured !== b.data.featured) return b.data.featured ? 1 : -1;
  if (a.data.order !== b.data.order) return a.data.order - b.data.order;
  return b.data.year - a.data.year;
});

const currentIndex = sortedProjects.findIndex(p => p.id === slug);
const nextProject = currentIndex < sortedProjects.length - 1 ? sortedProjects[currentIndex + 1] : null;

const pageTitle = `${data.title} — STUDIO KRÍA`;
const pageDescription = data.description;
const pageImage = data.heroImage || data.thumbnail;

// Prepare gallery images for lightbox (first 4 images from gallery, or hero + gallery)
const stillsImages = data.gallery && data.gallery.length > 0
  ? data.gallery.slice(0, 4).map(img => assetUrl(img))
  : data.heroImage
    ? [assetUrl(data.heroImage)]
    : [];

const hasStills = stillsImages.length > 0;

// Helper: Extract YouTube video ID from various URL formats
function getYouTubeVideoId(url: string): string | null {
  const patterns = [
    /(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/embed\/)([^&\n?#]+)/,
    /youtube\.com\/shorts\/([^&\n?#]+)/,
  ];
  for (const pattern of patterns) {
    const match = url.match(pattern);
    if (match) return match[1];
  }
  return null;
}

const youtubeVideoId = data.videoUrl ? getYouTubeVideoId(data.videoUrl) : null;
const isYouTube = !!youtubeVideoId;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  image={pageImage}
  type="article"
  locale={locale}
  translations={translations}
  pathname={pathname}
>
  {/* Portrait Hero - Desktop: 4:5 with overlay, Mobile: title on image, content below */}
  <header class="project-hero" aria-labelledby="project-title">
    <div class="project-hero-image" aria-hidden="true">
      {data.heroImage && (
        <img
          src={assetUrl(data.heroImage)}
          alt=""
          loading="eager"
          fetchpriority="high"
          sizes="(max-width: 768px) 100vw, (min-width: 1200px) 50vw, 100vw"
        />
      )}
    </div>

    <div class="project-hero-overlay">
      {/* Desktop content container */}
      <div class="project-hero-content container animate-on-scroll">
        <div class="project-hero-overlay-content">
          <div class="project-hero-meta">
            <span class="tag tag--accent">{typeLabels[data.type] || data.type}</span>
            <span class="tag tag--muted">{data.year}</span>
            {data.duration && <span class="tag tag--muted">{data.duration}</span>}
            <span class="tag tag--status" style={`--status-color: ${statusColors[data.status] || 'var(--accent)'};`}>
              {statusLabels[data.status] || data.status}
            </span>
          </div>

          <h1 id="project-title" class="project-title glitch-text" data-text={data.title}>
            {data.title}
          </h1>

          {data.role && data.role.length > 0 && (
            <p class="project-role">{data.role.join(' / ')}</p>
          )}

          <p class="project-description lead">{data.description}</p>

          {data.festival && data.festival.length > 0 && (
            <div class="project-festivals">
              {data.festival.map(fest => (
                <span class="festival-badge">{fest}</span>
              ))}
            </div>
          )}

          {hasStills && (
            <button class="btn btn-primary btn-lg glow-element stills-btn"
                    onclick="window.openLightbox(0)"
                    aria-label={t(locale, 'projects.viewStills')}>
              {t(locale, 'projects.viewStills')}
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                <circle cx="8.5" cy="8.5" r="1.5"/>
                <polyline points="21 15 16 10 5 21"/>
              </svg>
            </button>
          )}

          {data.videoUrl && (
            <button class="btn btn-primary btn-lg glow-element watch-film-btn"
                    onclick="window.openVideoLightbox()"
                    aria-label={t(locale, 'projects.watchFilm')}>
              {t(locale, 'projects.watchFilm')}
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <polygon points="5 3 19 12 5 21 5 3"/>
                <path d="M21 12l-6 6M21 12l-6-6"/>
              </svg>
            </button>
          )}
        </div>
      </div>

      {/* Mobile: only title on image - FULL WIDTH, outside container */}
      <div class="project-hero-mobile-title">
        <h1 id="project-title-mobile" class="project-title glitch-text" data-text={data.title}>
          {data.title}
        </h1>
      </div>
    </div>

    </header>

  {/* Mobile: Action buttons directly below hero image - NO background */}
  <div class="project-hero-mobile-buttons animate-on-scroll">
    <div class="container">
      {hasStills && (
        <button class="btn btn-primary btn-lg glow-element stills-btn"
                onclick="window.openLightbox(0)"
                aria-label={t(locale, 'projects.viewStills')}>
          {t(locale, 'projects.viewStills')}
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
            <circle cx="8.5" cy="8.5" r="1.5"/>
            <polyline points="21 15 16 10 5 21"/>
          </svg>
        </button>
      )}

      {data.videoUrl && (
        <button class="btn btn-primary btn-lg glow-element watch-film-btn"
                onclick="window.openVideoLightbox()"
                aria-label={t(locale, 'projects.watchFilm')}>
          {t(locale, 'projects.watchFilm')}
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <polygon points="5 3 19 12 5 21 5 3"/>
            <path d="M21 12l-6 6M21 12l-6-6"/>
          </svg>
        </button>
      )}
    </div>
  </div>

  {/* Mobile Hero Content - Below image on mobile only (meta, role, description, festivals only - NO buttons) */}
  <div class="project-hero-mobile-content animate-on-scroll">
    <div class="container">
      <div class="project-hero-meta">
        <span class="tag tag--accent">{typeLabels[data.type] || data.type}</span>
        <span class="tag tag--muted">{data.year}</span>
        {data.duration && <span class="tag tag--muted">{data.duration}</span>}
        <span class="tag tag--status" style={`--status-color: ${statusColors[data.status] || 'var(--accent)'};`}>
          {statusLabels[data.status] || data.status}
        </span>
      </div>

      {data.role && data.role.length > 0 && (
        <p class="project-role">{data.role.join(' / ')}</p>
      )}

      <p class="project-description lead">{data.description}</p>

      {data.festival && data.festival.length > 0 && (
        <div class="project-festivals">
          {data.festival.map(fest => (
            <span class="festival-badge">{fest}</span>
          ))}
        </div>
      )}
    </div>
  </div>

  {/* Lightbox for stills */}
  {hasStills && (
    <Lightbox images={stillsImages} alt={`${data.title} stills`} />
  )}

  {data.videoUrl && (
    <VideoLightbox
      videoUrl={data.videoUrl}
      title={data.title}
      isYouTube={isYouTube}
      youtubeVideoId={youtubeVideoId}
      locale={locale}
    />
  )}

  {/* Details Section */}
  <section class="project-details section section-compact" aria-labelledby="details-title">
    <div class="container">
      <div class="details-grid">
        <div class="details-content animate-on-scroll">
          <h2 id="details-title" class="section-title">{t(locale, 'projects.aboutProject')}</h2>
          <div class="details-body" set:html={body} />
        </div>

        <aside class="details-sidebar animate-on-scroll">
          {/* Credits - Redesigned as uniform tags */}
          <div class="credits-wrapper">
            <h3 class="details-card-title">{t(locale, 'projects.credits')}</h3>
            <div class="credits-tags" role="list">
              {(data.credits || data.role?.map(r => ({label: r, value: 'STUDIO KRÍA'})) || []).map((credit, index) => (
                <div class="credit-tag" style={`--stagger: ${index * 60}ms`} role="listitem">
                  <span class="credit-label">{credit.label}</span>
                  <span class="credit-value">{credit.value}</span>
                </div>
              ))}
              {data.duration && (
                <div class="credit-tag" style={`--stagger: ${(data.credits?.length || data.role?.length || 0) * 60}ms`} role="listitem">
                  <span class="credit-label">{t(locale, 'projects.runtime')}</span>
                  <span class="credit-value">{data.duration}</span>
                </div>
              )}
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  {/* Navigation to other projects - Next Project + Back to Projects */}
  <nav class="project-nav section" aria-label={t(locale, 'common.navigation') || 'Project navigation'}>
    <div class="container">
      <div class="nav-grid">
        {/* Next Project - Right side with image preview (Desktop) / Top (Mobile) */}
        {nextProject && (
          <a href={localUrl(`/projects/${nextProject.id}/`)} class="nav-card next-card animate-on-scroll">
            <div class="nav-card-content">
              <span class="nav-card-label">{t(locale, 'projects.nextProject')}</span>
              <h3 class="nav-card-title">{nextProject.data.title}</h3>
              <span class="nav-card-year">{nextProject.data.year}</span>
            </div>
            <div class="nav-card-image">
              <img src={assetUrl(nextProject.data.thumbnail)} alt="" loading="lazy" />
            </div>
            <svg class="nav-card-arrow" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        )}

        {/* Back to Projects Index - Left side (Desktop) / Bottom (Mobile) */}
        <a href={localUrl('/projects/')} class="nav-link-all animate-on-scroll">
          <span>{t(locale, 'projects.allProjectsTitle')}</span>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M19 12H5M12 19l-7-7 7-7"/>
          </svg>
        </a>
      </div>
    </div>
  </nav>
</Layout>

<style>
  /* ==========================================================================
     PROJECT HERO - Desktop: FULL WIDTH (no container), NO crop
     Mobile: 4:5 crop stacked layout
     ========================================================================== */

  /* Base: full-width container */
  .project-hero {
    position: relative;
    width: 100vw;
    max-width: none;
    margin-left: calc(50% - 50vw);
  }

  /* Desktop: Full width, NO crop - full image visible */
  @media (min-width: 769px) {
    .project-hero {
      aspect-ratio: auto;
      height: auto;
    }

    .project-hero-image {
      position: relative;
      width: 100%;
      aspect-ratio: auto;
      height: auto;
    }

    .project-hero-image img {
      width: 100%;
      height: auto;
      object-fit: contain;
      display: block;
    }

    .project-hero-overlay {
      position: absolute;
      inset: 0;
      z-index: 1;
      background: linear-gradient(
        180deg,
        rgba(5, 5, 5, 0.15) 0%,
        rgba(5, 5, 5, 0.25) 30%,
        rgba(5, 5, 5, 0.5) 60%,
        rgba(5, 5, 5, 0.9) 100%
      );
      display: flex;
      align-items: flex-end;
      padding: var(--space-3xl) var(--space-xl);
    }

    .project-hero-content {
      width: 100%;
      max-width: var(--container-lg);
      margin: 0 auto;
      color: var(--fg);
    }
  }

  /* Mobile: Title on image, content below */
  @media (max-width: 768px) {
    .project-hero {
      position: relative;
      width: 100vw;
      max-width: none;
      margin-left: calc(50% - 50vw);
      aspect-ratio: 4 / 5;
      /* Fallback height in case aspect-ratio fails */
      min-height: 50vh;
    }

    .project-hero-image {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 0;
    }

    .project-hero-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center top;
      display: block;
    }

    .project-hero-overlay {
      position: absolute;
      inset: 0;
      z-index: 1;
      background: linear-gradient(
        180deg,
        rgba(5, 5, 5, 0.1) 0%,
        rgba(5, 5, 5, 0.2) 30%,
        rgba(5, 5, 5, 0.5) 60%,
        rgba(5, 5, 5, 0.95) 100%
      );
      display: flex;
      flex-direction: column;
      justify-content: flex-end; /* Push content to bottom */
      padding: var(--space-2xl) var(--space-lg);
    }

    .project-hero-content {
      width: 100%;
      max-width: var(--container-lg);
      margin: 0 auto;
      color: var(--fg);
    }

    /* Hide desktop overlay content on mobile */
    .project-hero-overlay-content {
      display: none;
    }

    /* Mobile title on image - at bottom, FULL VIEWPORT WIDTH */
    .project-hero-mobile-title {
      position: absolute;
      bottom: var(--space-2xl);
      left: 0;
      right: 0;
      width: auto;
      max-width: none;
      padding: 0; /* No horizontal padding - full viewport width */
      text-align: left;
      z-index: 2; /* Above overlay gradient */
    }

    .project-hero-mobile-title .project-title {
      font-size: var(--display-md);
      line-height: 1.1;
      letter-spacing: -0.02em;
      text-shadow: var(--glow-intense);
      /* Removed word-break constraints to allow full width */
    }
  }

  /* Mobile buttons directly below hero - NO background */
  .project-hero-mobile-buttons {
    display: none;
    padding: var(--space-lg) var(--space-lg) var(--space-xl);
    background: transparent;
  }

  @media (max-width: 768px) {
    .project-hero-mobile-buttons {
      display: flex;
      flex-direction: column;
      gap: var(--space-sm);
      align-items: stretch; /* Full width buttons */
    }

    .project-hero-mobile-buttons .stills-btn,
    .project-hero-mobile-buttons .watch-film-btn {
      width: 100%;
      max-width: none; /* Full width */
      justify-content: center;
      padding: var(--space-md) var(--space-xl);
    }
  }

  /* Hide mobile-only elements on desktop */
  @media (min-width: 769px) {
    .project-hero-mobile-title,
    .project-hero-mobile-buttons {
      display: none;
    }
  }

  /* Mobile Hero Content - Below image */
  .project-hero-mobile-content {
    display: none;
    padding: var(--space-2xl) var(--space-lg);
    background: transparent;
  }

  @media (max-width: 768px) {
    .project-hero-mobile-content {
      display: block;
    }

    .project-hero-mobile-content .project-hero-meta {
      gap: var(--space-md);
      font-size: var(--text-sm);
      margin-bottom: var(--space-xl);
      justify-content: flex-start;
    }

    .project-hero-mobile-content .project-role {
      font-size: var(--text-base);
      margin-bottom: var(--space-lg);
    }

    .project-hero-mobile-content .project-description {
      font-size: var(--text-base);
      margin-bottom: var(--space-xl);
      max-width: none;
      line-height: 1.7;
    }

    .project-hero-mobile-content .project-festivals {
      margin-bottom: var(--space-xl);
    }

    .project-hero-mobile-content .festival-badge {
      padding: var(--space-sm) var(--space-lg);
      font-size: var(--text-xs);
    }
  }

  .project-hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-bottom: var(--space-xl);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }

  @media (max-width: 768px) {
    .project-hero-meta {
      gap: var(--space-sm);
      font-size: var(--text-xs);
      margin-bottom: var(--space-lg);
    }
  }

  .project-title {
    font-size: var(--display-xl);
    line-height: 0.9;
    margin-bottom: var(--space-lg);
    letter-spacing: -0.02em;
    text-shadow: var(--glow-intense);
    max-width: 90%;
    /* Prevent word splitting - wrap at word boundaries only */
    overflow-wrap: normal;
    word-break: normal;
    hyphens: none;
  }

  @media (max-width: 768px) {
    .project-title {
      font-size: var(--display-md);
      margin-bottom: var(--space-md);
      max-width: none;
      /* Prevent word splitting */
      overflow-wrap: normal;
      word-break: normal;
      hyphens: none;
    }
  }

  @media (max-width: 480px) {
    .project-title {
      font-size: var(--display-sm);
      /* Prevent word splitting */
      overflow-wrap: normal;
      word-break: normal;
      hyphens: none;
    }
  }

  .project-role {
    font-size: var(--text-lg);
    font-weight: 400;
    color: var(--accent);
    margin-bottom: var(--space-xl);
    text-transform: none;
    letter-spacing: 0;
    font-family: var(--font-sans);
    opacity: 0.95;
  }

  @media (max-width: 768px) {
    .project-role {
      font-size: var(--text-base);
      margin-bottom: var(--space-lg);
    }
  }

  .project-description {
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--fg-muted);
    max-width: 65ch;
    margin-bottom: var(--space-2xl);
  }

  @media (max-width: 768px) {
    .project-description {
      font-size: var(--text-sm);
      margin-bottom: var(--space-xl);
    }
  }

  .project-festivals {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-2xl);
  }

  .festival-badge {
    padding: var(--space-sm) var(--space-lg);
    background: rgba(232, 197, 138, 0.15);
    border: 1px solid rgba(232, 197, 138, 0.3);
    border-radius: var(--radius-full);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
    backdrop-filter: blur(4px);
  }

  .stills-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
  }

  @media (max-width: 768px) {
    .stills-btn {
      width: 100%;
      justify-content: center;
      padding: var(--space-md) var(--space-xl);
    }
  }

  .project-hero-play {
    position: absolute;
    bottom: var(--space-2xl);
    right: var(--space-2xl);
    width: 80px;
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--accent);
    border-radius: 50%;
    color: var(--bg);
    transition: all var(--transition-spring);
    z-index: 10;
    box-shadow: var(--glow-strong);
  }

  .project-hero-play:hover {
    transform: scale(1.1);
    box-shadow: var(--glow-intense);
    background: var(--accent-bright);
  }

  @media (max-width: 768px) {
    .project-hero-play {
      position: static;
      width: 100%;
      height: auto;
      border-radius: var(--radius-sm);
      justify-content: center;
      padding: var(--space-md) var(--space-xl);
      gap: var(--space-sm);
      margin-top: var(--space-lg);
      box-shadow: none;
      background: transparent;
      border: 2px solid var(--accent);
      color: var(--accent);
    }

    .project-hero-play:hover {
      background: var(--accent);
      color: var(--bg);
      border-color: var(--accent);
    }

    .project-hero-play svg {
      width: 20px;
      height: 20px;
    }
  }

  /* Details */
  .project-details {
    padding: var(--space-4xl) 0;
    background: transparent;
  }

  .details-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3xl);
  }

  @media (min-width: 1024px) {
    .details-grid {
      grid-template-columns: 1fr 380px;
      align-items: start;
    }
    .details-sidebar { position: sticky; top: var(--space-3xl); }
  }

  .details-body {
    font-size: var(--text-base);
    line-height: 1.85;
    color: var(--fg-muted);
  }

  .details-body h2,
  .details-body h3 {
    font-family: var(--font-display);
    color: var(--fg);
    margin: var(--space-2xl) 0 var(--space-lg);
  }

  .details-body h2 { font-size: var(--text-2xl); }
  .details-body h3 { font-size: var(--text-xl); }

  .details-body p { margin-bottom: var(--space-lg); }
  .details-body ul, .details-body ol { margin: var(--space-lg) 0; padding-left: var(--space-xl); }
  .details-body li { margin-bottom: var(--space-sm); }

  .details-card-title {
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--space-lg);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--border);
  }

  /* Credits - Redesigned as uniform tags */
  .credits-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .credit-tag {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-display);

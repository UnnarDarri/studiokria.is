---
/**
 * Projects Index - Full-width cinematic grid (sensor.tv inspired, grittier)
 * All projects displayed with massive full-bleed images
 */
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import { t, getTranslation } from '../../../i18n';

export async function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'is' } },
  ];
}

const locale = Astro.params.lang;
const translations = getTranslation(locale);
const basePath = import.meta.env.BASE_URL || '/';
// Helper to add base path to asset URLs (for images from content)
const assetUrl = (path: string) => `${basePath.replace(/\/$/, '')}${path.startsWith('/') ? path : '/' + path}`;
const localUrl = (path: string) => `${basePath.replace(/\/$/, '')}/${locale}${path.startsWith('/') ? path : '/' + path}`;
const pathname = '/projects/'; // Current path without base path

const projects = await getCollection('projects');

// Sort: featured first, then by order, then year desc
const sortedProjects = [...projects].sort((a, b) => {
  if (a.data.featured !== b.data.featured) return b.data.featured ? 1 : -1;
  if (a.data.order !== b.data.order) return a.data.order - b.data.order;
  return b.data.year - a.data.year;
});

const typeLabels = translations.projectTypes;
const statusLabels = translations.projectStatus;
const statusColors: Record<string, string> = {
  'completed': 'var(--color-accent)',
  'in-production': '#e67e22',
  'pre-production': '#3498db',
  'development': '#9b59b6',
};

---

<Layout
  title={t(locale, 'projects.title')}
  description={translations.projects.description || 'Explore our complete portfolio of films, documentaries, commercials, and music videos. Full-width cinematic showcase.'}
  image="/assets/images/og-work.jpg"
  locale={locale}
  translations={translations}
  pathname={pathname}
>
  {/* Hero - Minimal, just the title */}
  <header class="work-hero" aria-labelledby="work-title">
    <div class="work-hero-content container animate-on-scroll">
      <p class="work-hero-label glitch-text" data-text={t(locale, 'projects.label')}>
        {t(locale, 'projects.label')}
      </p>
      <h1 id="work-title" class="work-hero-title glitch-text" data-text={t(locale, 'projects.title')}>
        {t(locale, 'projects.title')}
      </h1>
    </div>
  </header>

  {/* Full-Width Project Grid */}
  <main class="work-grid" role="list" aria-label={t(locale, 'projects.title')}>
    {sortedProjects.map((project, index) => (
      <article class={`work-item full-width-image ${project.data.featured ? 'featured' : ''} animate-on-scroll`} style={`--stagger: ${index * 80}ms`} role="listitem">
        <a href={localUrl(`/projects/${project.id}/`)} class="work-item-link" aria-label={`${t(locale, 'projects.viewProject')}: ${project.data.title} — ${typeLabels[project.data.type] || project.data.type}`}>
          {/* Full-bleed image */}
          <div class="work-item-image" aria-hidden="true">
            <img
              src={assetUrl(project.data.thumbnail)}
              alt=""
              loading={index < 3 ? 'eager' : 'lazy'}
              fetchpriority={index < 3 ? 'high' : 'auto'}
              sizes="(max-width: 768px) 100vw, (max-width: 1199px) 50vw, 100vw"
            />
            <div class="work-item-overlay">
              <div class="work-item-gradient"></div>
            </div>
          </div>

          {/* Content overlay on hover/focus */}
          <div class="work-item-content">
            <div class="work-item-meta">
              <span class="work-item-type" style={`--accent: ${statusColors[project.data.status] || 'var(--color-accent)'};`}>
                {typeLabels[project.data.type] || project.data.type}
              </span>
              <span class="work-item-year">{project.data.year}</span>
              {project.data.duration && <span class="work-item-duration">{project.data.duration}</span>}
              <span class="work-item-status" style={`--status-color: ${statusColors[project.data.status] || 'var(--color-accent)'};`}>
                {statusLabels[project.data.status] || project.data.status}
              </span>
            </div>

            <h2 class="work-item-title glitch-text" data-text={project.data.title}>
              {project.data.title}
            </h2>

            {project.data.role && project.data.role.length > 0 && (
              <p class="work-item-role">{project.data.role.join(' / ')}</p>
            )}

            <p class="work-item-desc">{project.data.description}</p>

            {project.data.festival && project.data.festival.length > 0 && (
              <div class="work-item-festivals">
                {project.data.festival.slice(0, 4).map(fest => (
                  <span class="festival-chip">{fest}</span>
                ))}
                {project.data.festival.length > 4 && (
                  <span class="festival-chip more">+{project.data.festival.length - 4}</span>
                )}
              </div>
            )}
          </div>
        </a>
      </article>
    ))}
  </main>

  {/* CTA to return home */}
  <footer class="work-footer section section-compact">
    <div class="container">
      <div class="work-footer-content animate-on-scroll">
        <h2 class="work-footer-title glitch-text" data-text={t(locale, 'projects.wantToWork')}>
          {t(locale, 'projects.wantToWork')}
        </h2>
        <p class="work-footer-desc">{t(locale, 'projects.openToCollab')}</p>
        <a href={localUrl('/contact/')} class="btn btn-primary btn-xl glow-element-intense">
          {t(locale, 'projects.startProject')}
        </a>
      </div>
    </div>
  </footer>
</Layout>

<style>
  /* ==========================================================================
     WORK HERO - MINIMAL, BOLD
     ========================================================================== */
  .work-hero {
    position: relative;
    min-height: 60vh;
    min-height: 60dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4xl) var(--space-xl);
    text-align: center;
    border-bottom: 1px solid var(--color-border);
  }

  .work-hero-content { max-width: var(--container-lg); }

  .work-hero-label {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.5em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--space-xl);
    opacity: 0.7;
  }

  .work-hero-title {
    font-size: var(--display-xl);
    line-height: 0.85;
    letter-spacing: var(--letter-spacing-display);
    margin-bottom: var(--space-2xl);
    text-shadow: var(--glow-intense);
  }

  /* ==========================================================================
     WORK GRID - FULL WIDTH, CINEMATIC SINGLE COLUMN ON DESKTOP
     ========================================================================== */
  .work-grid {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }

  /* Tablet: 2 columns */
  @media (min-width: 768px) and (max-width: 1199px) {
    .work-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Desktop: Full-width single column - cinematic scrolling */
  @media (min-width: 1200px) {
    .work-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Featured projects get more height */
  @media (min-width: 768px) {
    .work-item.featured { aspect-ratio: 21 / 9; }
  }

  .work-item-link {
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .work-item-image {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .work-item-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94), filter 0.4s ease;
    filter: contrast(1.1) saturate(0.8);
    will-change: transform, filter;
  }

  .work-item:hover .work-item-image img,
  .work-item:focus-within .work-item-image img {
    transform: scale(1.03);
    filter: contrast(1.15) saturate(1) brightness(1.05);
  }

  .work-item-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      transparent 30%,
      rgba(5,5,5,0.4) 60%,
      rgba(5,5,5,0.9) 100%
    );
    opacity: 0.7;
    transition: opacity 0.6s ease;
  }

  .work-item:hover .work-item-gradient,
  .work-item:focus-within .work-item-gradient {
    opacity: 1;
  }

  .work-item-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  /* Content overlay */
  .work-item-content {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: var(--space-2xl) var(--space-xl);
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .work-item:hover .work-item-content,
  .work-item:focus-within .work-item-content {
    opacity: 1;
    transform: translateY(0);
  }

  .work-item-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
    margin-bottom: var(--space-lg);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }

  .work-item-type,
  .work-item-status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-xs) var(--space-sm);
    border: 1px solid currentColor;
    border-radius: var(--radius-full);
    background: rgba(5,5,5,0.6);
    backdrop-filter: blur(8px);
  }

  .work-item-type {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .work-item-status {
    color: var(--status-color);
    border-color: var(--status-color);
  }

  .work-item-year,
  .work-item-duration {
    color: var(--color-fg-subtle);
    background: transparent;
  }

  .work-item-title {
    font-size: var(--display-md);
    line-height: 0.95;
    letter-spacing: var(--letter-spacing-card);
    margin-bottom: var(--space-md);
    text-shadow: var(--glow-strong);
    max-width: 90%;
  }

  /* Desktop: larger titles for full-width items */
  @media (min-width: 1200px) {
    .work-item-title {
      font-size: var(--display-lg);
      letter-spacing: var(--letter-spacing-section);
    }
  }

  .work-item-role {
    font-size: var(--text-base);
    font-weight: 400;
    color: var(--color-accent);
    margin-bottom: var(--space-md);
    text-transform: none;
    letter-spacing: 0;
    font-family: var(--font-sans);
    opacity: 0.9;
  }

  .work-item-desc {
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-fg-muted);
    max-width: 50ch;
    margin-bottom: var(--space-lg);
    opacity: 0.8;
  }

  .work-item-festivals {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-bottom: var(--space-xl);
  }

  .festival-chip {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: var(--space-xs) var(--space-sm);
    background: rgba(232, 197, 138, 0.15);
    border: 1px solid rgba(232, 197, 138, 0.3);
    border-radius: var(--radius-full);
    color: var(--color-accent);
    backdrop-filter: blur(4px);
  }

  .festival-chip.more {
    background: rgba(118, 118, 118, 0.15);
    border-color: rgba(118, 118, 118, 0.3);
    color: var(--color-fg-subtle);
  }

  /* ==========================================================================
     WORK FOOTER
     ========================================================================== */
  .work-footer {
    text-align: center;
    border-top: 1px solid var(--color-border);
    background: transparent;
  }

  .work-footer-title {
    font-size: var(--display-lg);
    line-height: 1;
    margin-bottom: var(--space-lg);
    text-shadow: var(--glow-intense);
  }

  .work-footer-desc {
    font-size: var(--text-lg);
    color: var(--color-fg-muted);
    max-width: 50ch;
    margin: 0 auto var(--space-2xl);
  }

  /* ==========================================================================
     REDUCED MOTION
     ========================================================================== */
  @media (prefers-reduced-motion: reduce) {
    .work-item-image img { transition: none; }
    .work-item-content { opacity: 1; transform: none; transition: none; }
    .work-item-gradient { transition: none; }
  }

  /* ==========================================================================
     MOBILE - Title and tags BELOW the image
     ========================================================================== */
  @media (max-width: 768px) {
    .work-hero { min-height: 50vh; padding: var(--space-3xl) var(--space-lg); }
    .work-hero-title { font-size: var(--display-md); }

    /* Reset absolute positioning for mobile - stack image and content */
    .work-item {
      position: relative;
      aspect-ratio: auto;
      height: auto;
      display: flex;
      flex-direction: column;
    }
    .work-item.featured { aspect-ratio: auto; }

    .work-item-image {
      position: relative;
      aspect-ratio: 16 / 10;
      height: auto;
    }
    .work-item.featured .work-item-image {
      aspect-ratio: 16 / 8;
    }

    .work-item-gradient { display: none; }

    .work-item-content {
      position: relative;
      opacity: 1;
      transform: none;
      padding: var(--space-lg) var(--space-md);
      background: transparent;
      flex: 0 0 auto;
    }

    .work-item-meta {
      margin-bottom: var(--space-md);
      gap: var(--space-md);
      font-size: var(--text-xs);
    }

    .work-item-type,
    .work-item-status {
      padding: var(--space-xs) var(--space-sm);
      background: transparent;
      backdrop-filter: none;
    }

    .work-item-title {
      font-size: var(--display-sm);
      text-shadow: var(--glow-medium);
      max-width: none;
    }

    .work-item-role { font-size: var(--text-sm); margin-bottom: var(--space-sm); }

    .work-item-desc { display: none; }
    .work-item-festivals { display: none; }
  }
</style>
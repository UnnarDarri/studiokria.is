---
/**
 * Projects Index - Fixed viewport scroll animation (sensor.tv style)
 * One project at a time, next slides up to replace current
 */
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import HeroGradient from '../../../components/HeroGradient.astro';
import { t, getTranslation } from '../../../i18n';

export async function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'is' } },
  ];
}

const locale = Astro.params.lang;
const translations = getTranslation(locale);
const basePath = import.meta.env.BASE_URL || '/';
const assetUrl = (path: string) => `${basePath.replace(/\/$/, '')}${path.startsWith('/') ? path : '/' + path}`;
const localUrl = (path: string) => `${basePath.replace(/\/$/, '')}/${locale}${path.startsWith('/') ? path : '/' + path}`;
const pathname = '/projects/';

const projects = await getCollection('projects');

const sortedProjects = [...projects].sort((a, b) => {
  if (a.data.featured !== b.data.featured) return b.data.featured ? 1 : -1;
  if (a.data.order !== b.data.order) return a.data.order - b.data.order;
  return b.data.year - a.data.year;
});

const projectCount = sortedProjects.length;
// Scroll track multiplier - reduced for lighter scroll feel
const scrollMultiplier = 1.5; // Each project gets 150vh of scroll track
---

<Layout
  title={t(locale, 'projects.title')}
  description={translations.projects.description || 'Explore our complete portfolio of films, documentaries, commercials, and music videos. Full-width cinematic showcase.'}
  image="/assets/images/og-work.svg"
  locale={locale}
  translations={translations}
  pathname={pathname}
>
  <HeroGradient />

  {/* Hero - Minimal, just the title */}
  <header class="work-hero" aria-labelledby="work-title">
    <div class="work-hero-content container animate-on-scroll">
      <p class="work-hero-label glitch-text" data-text={t(locale, 'projects.label')}>
        {t(locale, 'projects.label')}
      </p>
      <h1 id="work-title" class="work-hero-title glitch-text" data-text={t(locale, 'projects.title')}>
        {t(locale, 'projects.title')}
      </h1>
    </div>
  </header>

  {/* Scroll Track - provides scroll length (scrollMultiplier * 100vh per project) */}
  <div class="work-scroll-track" aria-hidden="true"></div>

  {/* Fixed Viewport - shows one project at a time */}
  <div class="work-viewport" role="list" aria-label={t(locale, 'projects.title')}>
    {sortedProjects.map((project, index) => (
      <article
        class={`work-item ${project.data.featured ? 'featured' : ''}`}
        style={`--index: ${index};`}
        role="listitem"
        data-index={index}
      >
        <a href={localUrl(`/projects/${project.id}/`)} class="work-item-link" aria-label={`${t(locale, 'projects.viewProject')}: ${project.data.title} — ${t(locale, `projectTypes.${project.data.type}`) || project.data.type}`}>
          {/* Full-bleed image */}
          <div class="work-item-image" aria-hidden="true">
            <img
              src={assetUrl(project.data.thumbnail)}
              alt=""
              loading={index < 2 ? 'eager' : 'lazy'}
              fetchpriority={index < 2 ? 'high' : 'auto'}
              sizes="100vw"
            />
            <div class="work-item-overlay">
              <div class="work-item-gradient"></div>
            </div>
          </div>

          {/* Content overlay - bottom left, always visible on desktop */}
          <div class="work-item-content">
            <h2 class="work-item-title glitch-text" data-text={project.data.title}>
              {project.data.title}
            </h2>
            <a href={localUrl(`/projects/${project.id}/`)} class="work-item-cta">
              {t(locale, 'projects.viewProject')}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
        </a>
      </article>
    ))}
  </div>

  {/* CTA to return home */}
  <footer class="work-footer section section-compact">
    <div class="container">
      <div class="work-footer-content animate-on-scroll">
        <h2 class="work-footer-title glitch-text" data-text={t(locale, 'projects.wantToWork')}>
          {t(locale, 'projects.wantToWork')}
        </h2>
        <p class="work-footer-desc">{t(locale, 'projects.openToCollab')}</p>
        <a href={localUrl('/contact/')} class="btn btn-primary btn-xl glow-element-intense">
          {t(locale, 'projects.startProject')}
        </a>
      </div>
    </div>
  </footer>
</Layout>

<script is:inline>
  // Fixed viewport scroll animation — optimized for performance
  function initScrollAnimation() {
    const viewport = document.querySelector('.work-viewport');
    const items = viewport?.querySelectorAll('.work-item');
    const track = document.querySelector('.work-scroll-track');
    if (!items || items.length < 2 || !track) {
      console.warn('Scroll animation: required elements not found', { viewport, items: items?.length, track });
      return;
    }

    const count = items.length;
    const scrollMultiplier = 1.5; // 150vh per project - lighter feel
    let scrollY = 0;
    let lastUpdate = 0;
    let animationStarted = false;
    let ticking = false;

    // Set body min-height and track height dynamically based on project count
    function setHeights() {
      const vh = window.innerHeight;
      const totalHeight = count * vh * scrollMultiplier;
      document.body.style.minHeight = `${totalHeight}px`;
      track.style.height = `${totalHeight}px`;
    }

    // Initial height setup
    setHeights();

    // Robust scroll position getter
    const getScrollY = () => {
      if (document.scrollingElement) return document.scrollingElement.scrollTop;
      if (document.documentElement.scrollTop) return document.documentElement.scrollTop;
      if (document.body.scrollTop) return document.body.scrollTop;
      if (window.scrollY !== undefined) return window.scrollY;
      if (window.pageYOffset !== undefined) return window.pageYOffset;
      return 0;
    };

    function update() {
      ticking = false;
      try {
        const newScrollY = getScrollY();
        // Only update if scroll position changed significantly
        if (Math.abs(newScrollY - scrollY) < 1 && animationStarted) return;
        scrollY = newScrollY;
        animationStarted = true;

        const vh = window.innerHeight;
        const projectHeight = vh * scrollMultiplier;
        const index = Math.min(Math.floor(scrollY / projectHeight), count - 1);
        const progress = (scrollY % projectHeight) / projectHeight; // 0 to 1

        items.forEach((item, i) => {
          let opacity, transform, zIndex;
          if (i === index) {
            opacity = 1 - progress;
            transform = `translate3d(0, ${-progress * 100}vh, 0)`;
            zIndex = '10';
          } else if (i === index + 1) {
            opacity = progress;
            transform = `translate3d(0, ${(1 - progress) * 100}vh, 0)`;
            zIndex = '5';
          } else if (i < index) {
            opacity = 0;
            transform = 'translate3d(0, -100vh, 0)';
            zIndex = '1';
          } else {
            opacity = 0;
            transform = 'translate3d(0, 100vh, 0)';
            zIndex = '1';
          }
          // Batch DOM writes
          item.style.opacity = String(opacity);
          item.style.transform = transform;
          item.style.zIndex = zIndex;
        });

        // Debug: expose scroll position on documentElement for inspection
        document.documentElement.style.setProperty('--debug-scroll-y', `${scrollY}px`);
        document.documentElement.style.setProperty('--debug-index', String(index));
        document.documentElement.style.setProperty('--debug-progress', progress.toFixed(2));
        document.documentElement.style.setProperty('--debug-vh', `${vh}px`);
        document.documentElement.style.setProperty('--debug-project-height', `${projectHeight}px`);
      } catch (e) {
        console.error('Scroll animation error:', e);
      }
    }

    // Throttled scroll handler using requestAnimationFrame
    function onScroll() {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }

    // Single scroll listener on window (most reliable)
    window.addEventListener('scroll', onScroll, { passive: true });

    // Update track height and body min-height on resize (debounced)
    let resizeTimeout;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(setHeights, 150);
    });

    // Initial update
    update();
  }

  // Ensure DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initScrollAnimation);
  } else {
    initScrollAnimation();
  }
</script>

<style>
  /* Force page scrollability - html is the root scroller */
  :global(html) {
    overflow-y: auto;
  }
  :global(body) {
    /* min-height set dynamically in JS based on project count */
  }

  /* ==========================================================================
     WORK HERO - MINIMAL, BOLD
     ========================================================================== */
  .work-hero {
    position: relative;
    z-index: 100; /* Above viewport */
    min-height: 60vh;
    min-height: 60dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4xl) var(--space-xl);
    text-align: center;
    border-bottom: 1px solid var(--border);
    background: var(--bg);
  }

  .work-hero-content { max-width: var(--container-lg); }

  .work-hero-label {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.5em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--space-xl);
    opacity: 0.7;
  }

  .work-hero-title {
    font-size: var(--display-xl);
    line-height: 0.85;
    letter-spacing: var(--letter-spacing-display);
    margin-bottom: var(--space-2xl);
    text-shadow: var(--glow-intense);
    white-space: nowrap;
  }

  /* ==========================================================================
     SCROLL TRACK - Provides scroll length
     ========================================================================== */
  .work-scroll-track {
    width: 100%;
    pointer-events: none;
  }

  /* ==========================================================================
     FIXED VIEWPORT - Shows one project at a time
     ========================================================================== */
  .work-viewport {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    z-index: 50;
    pointer-events: none;
    overflow: hidden;
  }

  .work-item {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    height: 100dvh;
    will-change: opacity, transform;
    pointer-events: auto;
    /* Initial state: all hidden below (JS will override) */
    opacity: 0;
    transform: translateY(100vh);
    z-index: 1;
  }

  /* First project visible initially (JS will override after init) */
  .work-item:nth-child(1) {
    opacity: 1;
    transform: translateY(0);
    z-index: 10;
  }

  .work-item-link {
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .work-item-image {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .work-item-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94), filter 0.4s ease;
    filter: contrast(1.1) saturate(0.8);
    will-change: transform, filter;
  }

  .work-item:hover .work-item-image img,
  .work-item:focus-within .work-item-image img {
    transform: scale(1.03);
    filter: contrast(1.15) saturate(1) brightness(1.05);
  }

  .work-item-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      transparent 30%,
      rgba(5,5,5,0.4) 60%,
      rgba(5,5,5,0.9) 100%
    );
    opacity: 0.7;
    transition: opacity 0.6s ease;
  }

  .work-item:hover .work-item-gradient,
  .work-item:focus-within .work-item-gradient {
    opacity: 1;
  }

  .work-item-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  /* Content overlay - bottom left, always visible on desktop */
  .work-item-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 2;
    padding: var(--space-2xl) var(--space-xl);
    pointer-events: none;
  }

  .work-item-title {
    font-size: var(--display-md);
    line-height: 0.95;
    letter-spacing: var(--letter-spacing-card);
    margin-bottom: var(--space-md);
    text-shadow: var(--glow-strong);
    max-width: 90%;
  }

  @media (min-width: 1200px) {
    .work-item-title {
      font-size: var(--display-lg);
      letter-spacing: var(--letter-spacing-section);
    }
  }

  /* CTA Button - small, inline with arrow */
  .work-item-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    background: transparent;
    border: 1px solid var(--accent);
    border-radius: var(--radius-full);
    padding: var(--space-xs) var(--space-md);
    cursor: pointer;
    transition: all var(--transition-fast);
    pointer-events: auto;
    width: fit-content;
  }

  .work-item-cta:hover,
  .work-item-cta:focus {
    background: var(--accent);
    color: var(--bg);
    box-shadow: var(--glow-medium);
  }

  .work-item-cta svg {
    transition: transform var(--transition-fast);
    flex-shrink: 0;
  }

  .work-item-cta:hover svg {
    transform: translateX(4px);
  }

  /* ==========================================================================
     WORK FOOTER - Positioned after scroll track
     ========================================================================== */
  .work-footer {
    position: relative;
    z-index: 100; /* Above viewport */
    text-align: center;
    border-top: 1px solid var(--border);
    background: var(--bg);
    padding: var(--space-4xl) var(--space-xl);
  }

  .work-footer-title {
    font-size: var(--display-lg);
    line-height: 1;
    margin-bottom: var(--space-lg);
    text-shadow: var(--glow-intense);
  }

  .work-footer-desc {
    font-size: var(--text-lg);
    color: var(--fg-muted);
    max-width: 50ch;
    margin: 0 auto var(--space-2xl);
  }

  /* ==========================================================================
     REDUCED MOTION
     ========================================================================== */
  @media (prefers-reduced-motion: reduce) {
    .work-item {
      opacity: 1 !important;
      transform: none !important;
      filter: none !important;
      transition: none !important;
    }
    .work-item-image img { transition: none; }
    .work-item-content { opacity: 1; transform: none; transition: none; }
    .work-item-gradient { transition: none; }
  }

  /* ==========================================================================
     MOBILE - Stack projects vertically, title overlay on image
     ========================================================================== */
  @media (max-width: 768px) {
    .work-hero { min-height: 40vh; padding: var(--space-2xl) var(--space-lg); }
    .work-hero-title { font-size: var(--display-md); }
    .work-hero-label { display: none; }

    .work-scroll-track { display: none; }
    .work-viewport {
      position: static;
      height: auto;
      pointer-events: auto;
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    .work-item {
      position: relative;
      height: auto;
      min-height: auto;
      display: block;
      margin: 0;
      padding: 0;
    }

    .work-item-link {
      display: block;
      width: 100%;
      margin: 0;
      padding: 0;
    }

    .work-item-image {
      position: relative;
      width: 100%;
      height: auto;
      margin: 0;
      padding: 0;
    }

    .work-item-image img {
      width: 100%;
      height: auto;
      object-fit: contain;
      display: block;
      margin: 0;
      padding: 0;
    }

    .work-item-gradient {
      display: block;
      opacity: 0.4;
    }

    .work-item-content {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 2;
      padding: var(--space-md) var(--space-md);
      pointer-events: auto;
      background: linear-gradient(180deg, transparent 0%, rgba(5,5,5,0.7) 100%);
    }

    .work-item-title {
      font-size: var(--display-sm);
      text-shadow: var(--glow-strong);
      max-width: none;
      margin-bottom: var(--space-xs);
    }

    .work-item-cta {
      font-size: var(--text-xs);
      padding: var(--space-xs) var(--space-sm);
    }

    .work-footer { padding: var(--space-2xl) var(--space-lg); }
  }
</style>
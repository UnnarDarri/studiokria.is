---
/**
 * Home Page - Studio Kria
 */
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import HeroGradient from '../../components/HeroGradient.astro';
import { getCollection } from 'astro:content';
import { getTranslation } from '../../i18n';

export async function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'is' } },
  ];
}

const locale = Astro.params.lang;
const translations = getTranslation(locale);
const basePath = import.meta.env.BASE_URL || '/';
const assetUrl = (path: string) => `${basePath.replace(/\/$/, '')}${path.startsWith('/') ? path : '/' + path}`;
const localUrl = (path: string) => `${basePath.replace(/\/$/, '')}/${locale}${path.startsWith('/') ? path : '/' + path}`;
const pathname = '/';

const projects = await getCollection('projects');
const sortedProjects = [...projects].sort((a, b) => {
  if (a.data.featured !== b.data.featured) return b.data.featured ? 1 : -1;
  if (a.data.order !== b.data.order) return a.data.order - b.data.order;
  return b.data.year - a.data.year;
});

const allProjects = sortedProjects.filter(p => p.data.heroImage || p.data.thumbnail);
const featuredProject = allProjects[0];

// Serialized project data for client-side rotation
const projectsData = allProjects.map(p => ({
  id: p.id,
  title: p.data.title,
  type: p.data.type,
  year: p.data.year,
  duration: p.data.duration,
  role: p.data.role,
  description: p.data.description,
  festival: p.data.festival,
  status: p.data.status,
  heroImage: p.data.heroImage,
  thumbnail: p.data.thumbnail,
}));
const projectsDataJson = JSON.stringify(projectsData);
const translationsJson = JSON.stringify(translations);

---

<Layout
  title="Studio Kria — Independent Film Production"
  description={translations.hero.description}
  image="/assets/images/og-home.svg"
  locale={locale}
  translations={translations}
  pathname={pathname}
>
  <HeroGradient />
  <Hero
    title="STUDIO KRÍA"
    description={translations.hero.subtitle}
    glitch={true}
    massive={true}
    centered={true}
    variant="home"
  />

  {/* Gateway Section - WORKS SERVICES GEAR ABOUT */}
  <section class="section gateway-section" aria-label={translations.home.gatewaySection || 'Main navigation'}>
    <div class="container">
      <div class="gateway-grid stagger-children animate-on-scroll">
        <a href={localUrl('/projects/')} class="gateway-card">
          <div class="gateway-card-image">
            <img src={assetUrl("/assets/images/gateway-projects.svg")} alt="" loading="lazy" />
          </div>
          <div class="gateway-card-gradient"></div>
          <div class="gateway-card-overlay"></div>
          <div class="gateway-card-content">
            <span class="gateway-card-label">{translations.home.allProjects}</span>
            <h3 class="gateway-card-title">{translations.home.projectsTitle}</h3>
            <p class="gateway-card-desc">{translations.home.projectsDesc}</p>
            <span class="gateway-card-action">{translations.home.viewAll} →</span>
          </div>
        </a>
        <a href={localUrl('/services/')} class="gateway-card">
          <div class="gateway-card-image">
            <img src={assetUrl("/assets/images/gateway-services.svg")} alt="" loading="lazy" />
          </div>
          <div class="gateway-card-gradient"></div>
          <div class="gateway-card-overlay"></div>
          <div class="gateway-card-content">
            <span class="gateway-card-label">{translations.home.ourServices}</span>
            <h3 class="gateway-card-title">{translations.home.servicesTitle}</h3>
            <p class="gateway-card-desc">{translations.home.servicesDesc}</p>
            <span class="gateway-card-action">{translations.home.learnMore} →</span>
          </div>
        </a>
        <a href={localUrl('/rentals/')} class="gateway-card">
          <div class="gateway-card-image">
            <img src={assetUrl("/assets/images/gateway-rentals.svg")} alt="" loading="lazy" />
          </div>
          <div class="gateway-card-gradient"></div>
          <div class="gateway-card-overlay"></div>
          <div class="gateway-card-content">
            <span class="gateway-card-label">{translations.home.equipmentRentals}</span>
            <h3 class="gateway-card-title">{translations.home.rentalsTitle}</h3>
            <p class="gateway-card-desc">{translations.home.rentalsDesc}</p>
            <span class="gateway-card-action">{translations.home.browseGear} →</span>
          </div>
        </a>
        <a href={localUrl('/about/')} class="gateway-card">
          <div class="gateway-card-image">
            <img src={assetUrl("/assets/images/gateway-about.svg")} alt="" loading="lazy" />
          </div>
          <div class="gateway-card-gradient"></div>
          <div class="gateway-card-overlay"></div>
          <div class="gateway-card-content">
            <span class="gateway-card-label">{translations.home.aboutUs}</span>
            <h3 class="gateway-card-title">{translations.home.aboutTitle}</h3>
            <p class="gateway-card-desc">{translations.home.aboutDesc}</p>
            <span class="gateway-card-action">{translations.home.readMore} →</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  {/* Featured Projects Section */}
  {featuredProject && (
    <section
      class="featured-projects section"
      aria-labelledby="featured-title"
      id="featuredProject"
      data-projects={projectsDataJson}
      data-locale={locale}
      data-base-path={basePath}
      data-translations={translationsJson}
    >
      <div class="container">
        <header class="section-header animate-on-scroll">
          <h2 id="featured-title" class="section-title glitch-text" data-text={translations.home.featuredProjects}>
            {translations.home.featuredProjects}
          </h2>
        </header>
        <div class="featured-showcase animate-on-scroll">
          {/* Carousel Navigation Arrow - Next Only */}
          <nav class="carousel-nav" aria-label={translations.home.carouselNav || 'Project carousel navigation'}>
            <button class="carousel-next" aria-label={translations.home.nextProject || 'Next project'} data-action="next">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M9 6l6 6-6 6"/>
              </svg>
            </button>
          </nav>

          <a href={localUrl(`/projects/${featuredProject.id}/`)} class="featured-showcase-link" aria-label={`${translations.projects.viewProject}: ${featuredProject.data.title} — ${translations.projectTypes[featuredProject.data.type] || featuredProject.data.type}`}>
            <div class="featured-showcase-image" aria-hidden="true">
              <!-- Two images for smooth crossfade/slide transition -->
              <img
                class="carousel-img is-active"
                src={assetUrl(featuredProject.data.heroImage || featuredProject.data.thumbnail)}
                alt=""
                loading="eager"
                fetchpriority="high"
                sizes="100vw"
              />
              <img
                class="carousel-img is-incoming"
                src=""
                alt=""
                loading="lazy"
                sizes="100vw"
                aria-hidden="true"
              />
              <div class="featured-showcase-overlay">
                <div class="featured-showcase-gradient"></div>
              </div>
            </div>

            <div class="featured-showcase-content">
              <div class="featured-showcase-meta">
                <span class="featured-showcase-type" style={`--accent: var(--accent);`}>
                  {translations.projectTypes[featuredProject.data.type] || featuredProject.data.type}
                </span>
                <span class="featured-showcase-year">{featuredProject.data.year}</span>
                {featuredProject.data.duration && <span class="featured-showcase-duration">{featuredProject.data.duration}</span>}
                <span class="featured-showcase-status" style={`--status-color: var(--accent);`}>
                  {translations.projectStatus[featuredProject.data.status] || featuredProject.data.status}
                </span>
              </div>

              <h2 class="featured-showcase-title glitch-text" data-text={featuredProject.data.title}>
                {featuredProject.data.title}
              </h2>

              {featuredProject.data.role && featuredProject.data.role.length > 0 && (
                <p class="featured-showcase-role">{featuredProject.data.role.join(' / ')}</p>
              )}

              <p class="featured-showcase-desc">{featuredProject.data.description}</p>

              {featuredProject.data.festival && featuredProject.data.festival.length > 0 && (
                <div class="featured-showcase-festivals">
                  {featuredProject.data.festival.slice(0, 4).map(fest => (
                    <span class="festival-chip">{fest}</span>
                  ))}
                  {featuredProject.data.festival.length > 4 && (
                    <span class="festival-chip festival-chip--more">+{featuredProject.data.festival.length - 4}</span>
                  )}
                </div>
              )}

              <div class="featured-showcase-action">
                <span>{translations.projects.viewProject}</span>
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </div>
            </div>
          </a>

          <div class="featured-showcase-rotation" aria-hidden="true">
            <span class="rotation-label">{translations.home.showcasing}</span>
            <div class="rotation-dots">
              {allProjects.map((_, i) => (
                <span class={`rotation-dot ${i === 0 ? 'active' : ''}`} data-index={i}></span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  {/* CTA Section - "Want to Work Together" text as link */}
  <section class="cta-section section section-compact" aria-labelledby="cta-link">
    <div class="container">
      <div class="cta-content animate-on-scroll">
        <a id="cta-link" href={localUrl('/contact/')} class="cta-link">
          {translations.projects.wantToWork}
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .featured-projects {
    background: transparent;
    /* No border - removed divider line */
    padding: var(--space-xl) var(--space-2xl) 0;
  }

  .featured-projects .section-header {
    padding-bottom: var(--space-lg);
    /* No border */
    margin-bottom: var(--space-lg);
  }

  .cta-section {
    background: transparent;
  }

  /* Carousel Navigation */
  .carousel-nav {
    position: absolute;
    top: 50%;
    right: var(--space-2xl);
    transform: translateY(-50%);
    z-index: calc(var(--z-content) + 10);
    pointer-events: none;
  }

  .carousel-next {
    pointer-events: auto;
    width: 64px;
    height: 64px;
    background: rgba(5, 5, 5, 0.6);
    border: 1px solid var(--border);
    border-radius: 50%;
    color: var(--fg);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color var(--transition-base), border-color var(--transition-base), color var(--transition-base);
    backdrop-filter: blur(8px);
    transform: translateY(-50%);
  }

  .carousel-next:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg);
    transform: translateY(-50%); /* Lock transform to prevent any hover movement */
  }

  .carousel-next svg {
    width: 24px;
    height: 24px;
  }

  @media (max-width: 768px) {
    .carousel-nav {
      right: var(--space-lg);
    }
    .carousel-next {
      width: 48px;
      height: 48px;
    }
  }

  .featured-showcase {
    position: relative;
    width: 100vw;
    margin-left: calc(50% - 50vw);
  }

  .featured-showcase-link {
    display: block;
    position: relative;
    text-decoration: none;
    color: inherit;
  }

  .featured-showcase-image {
    position: relative;
    width: 100%;
    aspect-ratio: 16/9;
    overflow: hidden;
  }

  .featured-showcase-image img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Base state: hidden, slightly zoomed (Ken Burns start) */
    opacity: 0;
    transform: scale(1.04);
    transition:
      opacity 1000ms cubic-bezier(0.25, 0.46, 0.45, 0.94),
      transform 1200ms cubic-bezier(0.25, 0.46, 0.45, 0.94),
      filter 600ms ease;
    filter: contrast(1.1) saturate(0.8);
    will-change: opacity, transform, filter;
  }

  /* Active image: fully visible, normal scale */
  .featured-showcase-image img.is-active {
    opacity: 1;
    transform: scale(1);
  }

  /* Hover zoom on active */
  .featured-showcase-link:hover .featured-showcase-image img.is-active {
    transform: scale(1.02);
    filter: contrast(1.15) saturate(1) brightness(1.05);
  }

  /* Content transitions - driven by container class */
  .featured-showcase-content {
    transition: opacity 500ms cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .featured-showcase.transitioning .featured-showcase-content {
    opacity: 0;
  }

  .featured-showcase-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .featured-showcase-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      transparent 30%,
      rgba(5,5,5,0.4) 60%,
      rgba(5,5,5,0.9) 100%
    );
    opacity: 0.7;
    transition: opacity 0.6s ease;
  }

  .featured-showcase-link:hover .featured-showcase-gradient {
    opacity: 1;
  }

  .featured-showcase-content {
    position: absolute;
    inset: 0;
    z-index: calc(var(--z-content) + 5);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: var(--space-4xl) var(--space-2xl) var(--space-3xl);
    /* Always visible - no hover reveal */
  }

  .featured-showcase-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
    margin-bottom: var(--space-xl);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .featured-showcase-type,
  .featured-showcase-status {
    color: var(--accent);
    text-shadow: var(--glow-soft);
  }

  .featured-showcase-year,
  .featured-showcase-duration {
    color: var(--fg-muted);
  }

  .featured-showcase-title {
    font-size: var(--display-md);
    line-height: 1;
    margin-bottom: var(--space-lg);
    letter-spacing: var(--letter-spacing-card);
    text-shadow: var(--glow-intense);
    max-width: 80%;
  }

  .featured-showcase-role {
    font-size: var(--text-sm);
    color: var(--accent);
    margin-bottom: var(--space-lg);
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .featured-showcase-desc {
    font-size: var(--text-lg);
    line-height: 1.7;
    color: var(--fg-muted);
    max-width: 60ch;
    margin-bottom: var(--space-2xl);
  }

  .featured-showcase-festivals {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-2xl);
  }

  .festival-chip {
    font-size: var(--text-xs);
    font-weight: 600;
    padding: var(--space-xs) var(--space-sm);
    background: transparent;
    border: 1px solid var(--border);
    color: var(--fg-muted);
    transition: all var(--transition-fast);
  }

  .festival-chip:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .festival-chip--more {
    background: var(--accent);
    color: var(--bg);
    border-color: var(--accent);
  }

  .featured-showcase-action {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    transition: gap var(--transition-fast);
  }

  .featured-showcase-link:hover .featured-showcase-action {
    gap: var(--space-md);
  }

  .featured-showcase-action svg {
    stroke: var(--accent);
    transition: transform var(--transition-fast);
  }

  .featured-showcase-link:hover .featured-showcase-action svg {
    transform: translateX(4px);
  }

  .featured-showcase-rotation {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    padding: var(--space-xl) var(--space-2xl);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--fg-subtle);
  }

  .rotation-dots {
    display: flex;
    gap: var(--space-sm);
  }

  .rotation-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--border);
    transition: all var(--transition-base);
    cursor: pointer;
  }

  @media (pointer: coarse) {
    .rotation-dot {
      width: 16px;
      height: 16px;
    }
    .rotation-dot.active {
      transform: scale(1.2);
    }
  }

  .rotation-dot.active {
    background: var(--accent);
    box-shadow: var(--glow-medium);
    transform: scale(1.3);
  }

  .rotation-dot:hover:not(.active) {
    background: var(--border-hover);
  }

  .gateway-section {
    background: transparent;
    padding: 0 0 var(--space-4xl);
  }

  .gateway-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }

  @media (min-width: 768px) {
    .gateway-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1200px) {
    .gateway-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .gateway-card {
    position: relative;
    display: block;
    text-decoration: none;
    color: inherit;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    overflow: hidden;
    transition: all var(--transition-slower);
    aspect-ratio: 16/9;
  }

  .gateway-card:hover {
    border-color: var(--accent);
    box-shadow: var(--glow-medium);
  }

  .gateway-card-image {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .gateway-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94), filter 0.4s ease;
    filter: contrast(1.1) saturate(0.8);
    will-change: transform, filter;
  }

  .gateway-card:hover .gateway-card-image img {
    transform: scale(1.03);
    filter: contrast(1.15) saturate(1) brightness(1.05);
  }

  .gateway-card-gradient {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      180deg,
      transparent 30%,
      rgba(5,5,5,0.4) 60%,
      rgba(5,5,5,0.9) 100%
    );
    opacity: 0.7;
    transition: opacity 0.6s ease;
  }

  .gateway-card:hover .gateway-card-gradient {
    opacity: 1;
  }

  .gateway-card-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  .gateway-card-content {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: var(--space-2xl) var(--space-xl);
    /* Always visible - no hover reveal */
  }

  .gateway-card-label {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--space-sm);
    text-shadow: var(--glow-soft);
  }

  .gateway-card-title {
    font-size: var(--display-sm);
    line-height: 1.1;
    margin-bottom: var(--space-md);
    letter-spacing: var(--letter-spacing-card);
    text-shadow: var(--glow-medium);
  }

  .gateway-card-desc {
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--fg-muted);
    margin-bottom: var(--space-lg);
    max-width: 50ch;
  }

  .gateway-card-action {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--fg);
    transition: gap var(--transition-fast);
  }

  .gateway-card:hover .gateway-card-action {
    gap: var(--space-md);
  }

  @media (max-width: 768px) {
    .gateway-card { aspect-ratio: 16/10; }
    .gateway-card-content {
      opacity: 1;
      transform: none;
      background: linear-gradient(180deg, transparent 0%, rgba(5,5,5,0.9) 100%);
    }
    .gateway-card-desc { display: none; }
    .gateway-card-title { font-size: var(--display-sm); }
  }

  .gateway-card-label {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--space-sm);
    text-shadow: var(--glow-soft);
  }

  .gateway-card-title {
    font-size: var(--display-sm);
    line-height: 1.1;
    margin-bottom: var(--space-md);
    letter-spacing: var(--letter-spacing-card);
    text-shadow: var(--glow-medium);
  }

  .gateway-card-desc {
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--fg-muted);
    margin-bottom: var(--space-lg);
  }

  .gateway-card-action {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--fg);
    transition: all var(--transition-fast);
  }

  .gateway-card:hover .gateway-card-action {
    color: var(--accent);
    gap: var(--space-md);
  }

  /* CTA Section - "Want to Work Together" text as link */
  .cta-section {
    background: transparent;
    text-align: center;
    border-top: 1px solid var(--border);
    padding: var(--space-4xl) 0 var(--space-5xl);
  }

  .cta-link {
    font-family: var(--font-display);
    font-size: var(--display-xl);
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: var(--letter-spacing-display);
    text-transform: uppercase;
    color: var(--fg);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .cta-link:hover {
    color: var(--accent);
  }

  @media (max-width: 768px) {
    .featured-projects { padding: var(--space-xl) var(--space-lg) 0; }
    .featured-showcase-image { aspect-ratio: 16/9; }
    .featured-showcase-content { padding: var(--space-xl) var(--space-lg) var(--space-lg); }
    .featured-showcase-title { font-size: var(--display-sm); max-width: 100%; }
    .featured-showcase-desc { display: none; }
    .featured-showcase-meta { display: none; }
    .featured-showcase-role { display: none; }
    .featured-showcase-festivals { display: none; }
    .featured-showcase-action { display: none; }
    .featured-showcase-rotation { flex-wrap: wrap; padding: var(--space-lg); }

    .gateway-section { padding: 0 var(--space-lg) var(--space-3xl); }
    .gateway-grid { gap: var(--space-lg); }
    .gateway-card-content { padding: var(--space-lg); }
    .gateway-card-title { font-size: var(--display-sm); }

    .cta-section { padding: var(--space-3xl) 0 var(--space-4xl); }
    .cta-link { font-size: var(--display-lg); }
    .cta-link svg { width: 24px; height: 24px; }
  }
</style>

<script is:inline>
  // Featured Project Rotation - Smooth slide/crossfade transition
  (function() {
    const showcase = document.getElementById('featuredProject');
    if (!showcase) return;

    // Read data from data attributes
    const projectsData = JSON.parse(showcase.dataset.projects || '[]');
    const locale = showcase.dataset.locale || 'en';
    const basePath = showcase.dataset.basePath || '/';
    const translations = JSON.parse(showcase.dataset.translations || '{}');

    if (projectsData.length <= 1) return;

    const link = showcase.querySelector('.featured-showcase-link');
    const imageContainer = showcase.querySelector('.featured-showcase-image');
    const activeImg = showcase.querySelector('.carousel-img.is-active');
    const incomingImg = showcase.querySelector('.carousel-img.is-incoming');
    const typeEl = showcase.querySelector('.featured-showcase-type');
    const yearEl = showcase.querySelector('.featured-showcase-year');
    const durationEl = showcase.querySelector('.featured-showcase-duration');
    const statusEl = showcase.querySelector('.featured-showcase-status');
    const titleEl = showcase.querySelector('.featured-showcase-title');
    const roleEl = showcase.querySelector('.featured-showcase-role');
    const descEl = showcase.querySelector('.featured-showcase-desc');
    const festivalsEl = showcase.querySelector('.featured-showcase-festivals');
    const dots = showcase.querySelectorAll('.rotation-dot');

    let currentIndex = 0;
    let rotationInterval = null;
    let isPaused = false;
    let displayStartTime = 0;
    let isAnimating = false;
    const ROTATION_INTERVAL = 6000;

    // Track which image element is currently active (0 or 1)
    let activeImageIndex = 0;
    const carouselImages = [activeImg, incomingImg];

    function assetUrl(path) {
      return basePath.replace(/\/$/, '') + (path.startsWith('/') ? path : '/' + path);
    }

    // Get content container for synchronized transitions
    const contentContainer = showcase.querySelector('.featured-showcase-content');

    function updateShowcase(index, direction = 'next') {
      if (isAnimating) return;
      const project = projectsData[index];
      if (!project) return;

      isAnimating = true;

      link.href = `${basePath.replace(/\/$/, '')}/${locale}/projects/${project.id}/`;
      link.setAttribute('aria-label', `${translations.projects?.viewProject || 'View Project'}: ${project.title} — ${translations.projectTypes?.[project.type] || project.type}`);

      // Determine which image element will be the next active one
      const nextActiveIndex = 1 - activeImageIndex;
      const nextActiveImg = carouselImages[nextActiveIndex];
      const currentActiveImg = carouselImages[activeImageIndex];

      // Set up the next image src
      const nextSrc = assetUrl(project.heroImage || project.thumbnail);
      nextActiveImg.src = nextSrc;
      nextActiveImg.alt = '';

      // Ensure new image is loaded before transition
      const startTransition = () => {
        // Start content fade-out (CSS-driven)
        if (contentContainer) {
          contentContainer.classList.add('transitioning');
        }

        // Start image crossfade: swap is-active class on both images simultaneously
        // Old: is-active → (none) = opacity 1 → 0
        // New: (none) → is-active = opacity 0 → 1
        currentActiveImg.classList.remove('is-active');
        nextActiveImg.classList.add('is-active');

        // Update text content at crossfade midpoint using transitionend
        // We'll use a single transitionend listener on the outgoing image
        let contentUpdated = false;

        const onTransitionEnd = (e) => {
          // Only care about opacity transition on the outgoing image
          if (e.propertyName !== 'opacity' || e.target !== currentActiveImg) return;

          currentActiveImg.removeEventListener('transitionend', onTransitionEnd);

          // Update text content now (at exact crossfade midpoint)
          if (!contentUpdated) {
            typeEl.textContent = translations.projectTypes?.[project.type] || project.type;
            yearEl.textContent = project.year;
            durationEl.textContent = project.duration || '';
            durationEl.style.display = project.duration ? 'inline' : 'none';
            statusEl.textContent = translations.projectStatus?.[project.status] || project.status;

            titleEl.textContent = project.title;
            titleEl.setAttribute('data-text', project.title);

            if (roleEl) {
              roleEl.textContent = project.role?.join(' / ') || '';
              roleEl.style.display = project.role?.length ? 'block' : 'none';
            }

            descEl.textContent = project.description;

            if (festivalsEl && project.festival) {
              festivalsEl.innerHTML = project.festival.slice(0, 4).map(fest =>
                `<span class="festival-chip">${fest}</span>`
              ).join('') + (project.festival.length > 4 ?
                `<span class="festival-chip festival-chip--more">+${project.festival.length - 4}</span>` : '');
            }

            dots.forEach((dot, i) => {
              dot.classList.toggle('active', i === index);
            });

            contentUpdated = true;
          }

          // Start content fade-in
          if (contentContainer) {
            contentContainer.classList.remove('transitioning');
          }
        };

        currentActiveImg.addEventListener('transitionend', onTransitionEnd);

        // Fallback: if transitionend doesn't fire (e.g., reduced motion), use timeout
        const fallbackTimer = setTimeout(() => {
          currentActiveImg.removeEventListener('transitionend', onTransitionEnd);
          if (!contentUpdated) {
            onTransitionEnd({ propertyName: 'opacity', target: currentActiveImg });
          }
        }, 1100); // Slightly longer than transition

        // After transition fully completes, swap active index and cleanup
        const onTransformEnd = (e) => {
          if (e.propertyName !== 'transform' || e.target !== currentActiveImg) return;
          currentActiveImg.removeEventListener('transitionend', onTransformEnd);
          clearTimeout(fallbackTimer);

          // Swap active index
          activeImageIndex = nextActiveIndex;

          // Cleanup: old image gets no classes (back to base hidden state)
          carouselImages[1 - activeImageIndex].classList.remove('is-active');
          imageContainer.classList.remove('is-reverse');

          currentIndex = index;
          displayStartTime = Date.now();
          isAnimating = false;
        };

        currentActiveImg.addEventListener('transitionend', onTransformEnd);

        // Master fallback: ensure cleanup even if transitionend events don't fire
        // (e.g., reduced motion, browser quirks, element removed)
        const masterFallback = setTimeout(() => {
          currentActiveImg.removeEventListener('transitionend', onTransitionEnd);
          currentActiveImg.removeEventListener('transitionend', onTransformEnd);
          clearTimeout(fallbackTimer);
          if (!contentUpdated) {
            // Force content update
            typeEl.textContent = translations.projectTypes?.[project.type] || project.type;
            yearEl.textContent = project.year;
            durationEl.textContent = project.duration || '';
            durationEl.style.display = project.duration ? 'inline' : 'none';
            statusEl.textContent = translations.projectStatus?.[project.status] || project.status;
            titleEl.textContent = project.title;
            titleEl.setAttribute('data-text', project.title);
            if (roleEl) {
              roleEl.textContent = project.role?.join(' / ') || '';
              roleEl.style.display = project.role?.length ? 'block' : 'none';
            }
            descEl.textContent = project.description;
            if (festivalsEl && project.festival) {
              festivalsEl.innerHTML = project.festival.slice(0, 4).map(fest =>
                `<span class="festival-chip">${fest}</span>`
              ).join('') + (project.festival.length > 4 ?
                `<span class="festival-chip festival-chip--more">+${project.festival.length - 4}</span>` : '');
            }
            dots.forEach((dot, i) => {
              dot.classList.toggle('active', i === index);
            });
            if (contentContainer) contentContainer.classList.remove('transitioning');
          }
          // Force cleanup
          activeImageIndex = nextActiveIndex;
          carouselImages[1 - activeImageIndex].classList.remove('is-active');
          imageContainer.classList.remove('is-reverse');
          currentIndex = index;
          displayStartTime = Date.now();
          isAnimating = false;
        }, 1500); // Longer than longest transition (1200ms)
      };

      // Preload image then start
      if (nextActiveImg.complete && nextActiveImg.naturalWidth > 0) {
        startTransition();
      } else {
        nextActiveImg.onload = startTransition;
        nextActiveImg.onerror = () => {
          // Even if image fails to load, proceed with transition
          startTransition();
        };
      }
    }

    function nextProject() {
      if (isPaused || isAnimating) return;
      const next = (currentIndex + 1) % projectsData.length;
      updateShowcase(next, 'next');
    }

    function prevProject() {
      if (isPaused || isAnimating) return;
      const prev = (currentIndex - 1 + projectsData.length) % projectsData.length;
      updateShowcase(prev, 'prev');
    }

    function startRotation() {
      if (rotationInterval) clearInterval(rotationInterval);
      rotationInterval = setInterval(nextProject, ROTATION_INTERVAL);
    }

    function stopRotation() {
      if (rotationInterval) clearInterval(rotationInterval);
      rotationInterval = null;
    }

    function scheduleNext() {
      // Smart timer: if we've displayed for >= ROTATION_INTERVAL, advance immediately
      // Otherwise wait for remaining time
      const elapsed = Date.now() - displayStartTime;
      const remaining = Math.max(0, ROTATION_INTERVAL - elapsed);

      if (remaining <= 100) {
        // Already past the interval, advance immediately
        nextProject();
        startRotation();
      } else {
        // Wait for remaining time
        setTimeout(() => {
          if (!isPaused && !isAnimating) {
            nextProject();
            startRotation();
          }
        }, remaining);
      }
    }

    // Initialize both images
    if (projectsData[0]) {
      // Set up first image as active
      activeImg.src = assetUrl(projectsData[0].heroImage || projectsData[0].thumbnail);
      activeImg.alt = '';
      activeImg.classList.add('is-active');

      // Preload second image if there are more projects
      if (projectsData.length > 1) {
        const secondSrc = assetUrl(projectsData[1].heroImage || projectsData[1].thumbnail);
        incomingImg.src = secondSrc;
        incomingImg.alt = '';
      }
    }

    // Initialize displayStartTime and text without animation
    currentIndex = 0;
    displayStartTime = Date.now();
    isAnimating = false;

    // Update text content for first project
    const firstProject = projectsData[0];
    if (firstProject) {
      typeEl.textContent = translations.projectTypes?.[firstProject.type] || firstProject.type;
      yearEl.textContent = firstProject.year;
      durationEl.textContent = firstProject.duration || '';
      durationEl.style.display = firstProject.duration ? 'inline' : 'none';
      statusEl.textContent = translations.projectStatus?.[firstProject.status] || firstProject.status;
      titleEl.textContent = firstProject.title;
      titleEl.setAttribute('data-text', firstProject.title);
      if (roleEl) {
        roleEl.textContent = firstProject.role?.join(' / ') || '';
        roleEl.style.display = firstProject.role?.length ? 'block' : 'none';
      }
      descEl.textContent = firstProject.description;
      if (festivalsEl && firstProject.festival) {
        festivalsEl.innerHTML = firstProject.festival.slice(0, 4).map(fest =>
          `<span class="festival-chip">${fest}</span>`
        ).join('') + (firstProject.festival.length > 4 ?
          `<span class="festival-chip festival-chip--more">+${firstProject.festival.length - 4}</span>` : '');
      }
      dots.forEach((dot, i) => {
        dot.classList.toggle('active', i === 0);
      });
    }

    startRotation();

    // Trigger first transition after a short delay so user sees it working
    setTimeout(() => {
      if (!isPaused && !isAnimating && projectsData.length > 1) {
        nextProject();
      }
    }, 3000); // 3 seconds for first transition

    // Dot navigation
    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        if (isAnimating) return;
        stopRotation();
        const direction = i > currentIndex ? 'next' : 'prev';
        updateShowcase(i, direction);
        startRotation();
      });
    });

    // Carousel navigation arrow (next only)
    const nextBtn = showcase.querySelector('.carousel-next');

    if (nextBtn) {
      nextBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        stopRotation();
        nextProject();
        startRotation();
      });
    }

    // Keyboard navigation
    showcase.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') {
        stopRotation();
        prevProject();
        startRotation();
      } else if (e.key === 'ArrowRight') {
        stopRotation();
        nextProject();
        startRotation();
      }
    });

    // Touch/swipe support for mobile
    let touchStartX = 0;
    let touchStartTime = 0;

    showcase.addEventListener('touchstart', (e) => {
      touchStartX = e.touches[0].clientX;
      touchStartTime = Date.now();
    }, { passive: true });

    showcase.addEventListener('touchend', (e) => {
      if (isAnimating) return;
      const touchEndX = e.changedTouches[0].clientX;
      const touchEndTime = Date.now();
      const deltaX = touchStartX - touchEndX;
      const deltaTime = touchEndTime - touchStartTime;
      const swipeThreshold = 50; // minimum swipe distance in pixels
      const maxSwipeTime = 300; // maximum swipe time in ms

      // Check if it's a valid swipe (fast enough and far enough)
      if (Math.abs(deltaX) > swipeThreshold && deltaTime < maxSwipeTime) {
        stopRotation();
        if (deltaX > 0) {
          // Swipe left - next project
          nextProject();
        } else {
          // Swipe right - previous project
          prevProject();
        }
        startRotation();
      }
    }, { passive: true });

    showcase.setAttribute('tabindex', '0');
  })();
</script>
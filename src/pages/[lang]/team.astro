---
/**
 * Team Page - The Four Founders
 * Brutal, raw layout showing only the founders
 */
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import HeroGradient from '../../components/HeroGradient.astro';
import { t, getTranslation } from '../../i18n';

export async function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'is' } },
  ];
}

const locale = Astro.params.lang;
const translations = getTranslation(locale);
const basePath = import.meta.env.BASE_URL || '/';
const assetUrl = (path: string) => `${basePath.replace(/\/$/, '')}${path.startsWith('/') ? path : '/' + path}`;
const localUrl = (path: string) => `${basePath.replace(/\/$/, '')}/${locale}${path.startsWith('/') ? path : '/' + path}`;
const pathname = '/team/';

// Get founders from translations
const founders = translations.about.founders || [];

---

<Layout
  title={t(locale, 'team.title')}
  description={translations.team.description}
  image="/assets/images/og-team.svg"
  locale={locale}
  translations={translations}
  pathname={pathname}
>
  <HeroGradient />

  {/* Hero */}
  <Hero
    title={t(locale, 'team.title')}
    class="hero-centered"
  />

  {/* Founders Grid */}
  <section class="section" aria-labelledby="founders-title">
    <div class="container">
      <header class="section-header animate-on-scroll">
        <h2 id="founders-title" class="section-title">{t(locale, 'team.coreTeam')}</h2>
      </header>
      <div class="founders-grid stagger-children animate-on-scroll">
        {founders.map((member, index) => (
          <div class="founder-card animate-on-scroll" style={`--stagger: ${index * 100}ms`}>
            <div class="founder-photo">
              {member.image && (
                <img src={assetUrl(member.image)} alt={`${member.name} — ${member.role}`} loading={index < 2 ? 'eager' : 'lazy'} />
              )}
              {!member.image && (
                <div class="founder-placeholder" aria-hidden="true">
                  <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <circle cx="12" cy="8" r="4"/>
                    <path d="M12 14v7M4 21c0-4 4-6 8-6s8 2 8 6"/>
                  </svg>
                </div>
              )}
            </div>
            <div class="founder-info">
              <h3 class="founder-name">{member.name}</h3>
              <p class="founder-role">{member.role}</p>
              {member.bio && <p class="founder-bio">{member.bio}</p>}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Founders Grid - Brutal, raw */
  .founders-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
    margin-top: var(--space-2xl);
  }

  @media (min-width: 768px) {
    .founders-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1200px) {
    .founders-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .founder-card {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
    padding: var(--space-lg);
    border: 1px solid var(--border);
    background: transparent;
    transition: all var(--transition-slower);
  }

  @media (min-width: 600px) {
    .founder-card {
      grid-template-columns: 150px 1fr;
      align-items: start;
    }
  }

  .founder-card:hover {
    border-color: var(--accent);
    transform: translateY(-4px);
    box-shadow: var(--glow-medium);
  }

  .founder-photo {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .founder-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slower);
  }

  .founder-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--fg-muted);
    opacity: 0.5;
  }

  .founder-card:hover .founder-photo img {
    transform: scale(1.05);
  }

  .founder-name {
    font-size: var(--text-xl);
    margin-bottom: var(--space-xs);
  }

  .founder-role {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--space-sm);
  }

  .founder-bio {
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--fg-muted);
    font-style: italic;
  }
</style>
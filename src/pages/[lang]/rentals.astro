---
/**
 * Rentals Page - Equipment and facility rentals
 * Card-based layout matching demo site
 */
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import { t, getTranslation } from '../../i18n';

export async function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'is' } },
  ];
}

const locale = Astro.params.lang;
const translations = getTranslation(locale);
const basePath = import.meta.env.BASE_URL || '/';
const assetUrl = (path: string) => `${basePath.replace(/\/$/, '')}${path.startsWith('/') ? path : '/' + path}`;
const localUrl = (path: string) => `${basePath.replace(/\/$/, '')}/${locale}${path.startsWith('/') ? path : '/' + path}`;
const pathname = '/rentals/'; // Current path without base path

const cameraPackages = translations.rentals.cameraPackages;
const otherCameras = translations.rentals.otherCameras;

---

<Layout
  title={t(locale, 'rentals.title')}
  description={translations.rentals.description}
  image="/assets/images/og-rentals.jpg"
  locale={locale}
  translations={translations}
  pathname={pathname}
>
  {/* Hero */}
  <Hero
    title={t(locale, 'rentals.title')}
    backgroundImage={assetUrl("/assets/images/rentals-hero.jpg")}
    ctaPrimary={{ text: t(locale, 'rentals.requestQuote'), href: localUrl('/contact/#rentals') }}
    ctaSecondary={{ text: t(locale, 'rentals.downloadRateCard'), href: '/assets/docs/kria-rate-card.pdf' }}
    class="hero-centered"
  />

  {/* Camera Packages */}
  <section class="section" aria-labelledby="cameras-title">
    <div class="container">
      <header class="section-header animate-on-scroll">
        <h2 id="cameras-title" class="section-title">{t(locale, 'rentals.cameras')}</h2>
      </header>
      <div class="rental-list stagger-children animate-on-scroll">
        {cameraPackages.map((pkg, index) => (
          <div class="rental-item animate-on-scroll" style={`--stagger: ${index * 80}ms`}>
            <h3 class="rental-name">{pkg.name}</h3>
            <p class="rental-price">{pkg.price}</p>
            <a href={localUrl(`/contact/#rentals?equipment=${pkg.name.toLowerCase().replace(/ /g, '')}`)} class="rental-link">
              {t(locale, 'rentals.enquire')}
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
        ))}
        <div class="rental-item animate-on-scroll">
          <h3 class="rental-name">{otherCameras.name}</h3>
          <a href={localUrl('/contact/#rentals')} class="rental-link">
            {t(locale, 'rentals.enquire')}
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* Lenses */}
  <section class="section" aria-labelledby="lenses-title">
    <div class="container">
      <header class="section-header animate-on-scroll">
        <h2 id="lenses-title" class="section-title">{t(locale, 'rentals.lenses')}</h2>
      </header>
      <div class="rental-grid stagger-children animate-on-scroll">
        {translations.rentals.lensList.map((lens, index) => (
          <div class="rental-item animate-on-scroll" style={`--stagger: ${index * 60}ms`}>
            <h3 class="rental-name">{lens.name}</h3>
            <p class="rental-specs">{lens.specs}</p>
            <p class="rental-price">{lens.price}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Lighting & Grip */}
  <section class="section" aria-labelledby="lighting-title">
    <div class="container">
      <header class="section-header animate-on-scroll">
        <h2 id="lighting-title" class="section-title">{t(locale, 'rentals.lighting')}</h2>
      </header>
      <div class="rental-grid stagger-children animate-on-scroll">
        {translations.rentals.lightingCategories.map((cat, index) => (
          <div class="rental-category animate-on-scroll" style={`--stagger: ${index * 80}ms`}>
            <h3 class="category-name">{cat.name}</h3>
            <p class="category-items">{cat.items}</p>
            <a href={localUrl(`/contact/#rentals?category=${cat.slug}`)} class="rental-link">
              {t(locale, 'rentals.enquire')}
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Facilities */}
  <section class="section" aria-labelledby="facilities-title">
    <div class="container">
      <header class="section-header animate-on-scroll">
        <h2 id="facilities-title" class="section-title">{t(locale, 'rentals.facilities')}</h2>
      </header>
      <div class="rental-grid stagger-children animate-on-scroll">
        {translations.rentals.facilityList.map((facility, index) => (
          <div class="rental-item facility-item animate-on-scroll" style={`--stagger: ${index * 80}ms`}>
            <h3 class="rental-name">{facility.name}</h3>
            <p class="rental-price">{facility.price}</p>
            <a href={localUrl(`/contact/#rentals?facility=${facility.slug}`)} class="rental-link">
              {t(locale, 'rentals.enquire')}
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Rental Terms */}
  <section class="section" aria-labelledby="terms-title">
    <div class="container">
      <header class="section-header animate-on-scroll">
        <h2 id="terms-title" class="section-title">{t(locale, 'rentals.terms')}</h2>
      </header>
      <div class="terms-grid stagger-children animate-on-scroll">
        {translations.rentals.termsList.map((term, index) => (
          <div class="term-item animate-on-scroll" style={`--stagger: ${index * 80}ms`}>
            <h3 class="term-title">{term.title}</h3>
            <p class="term-desc">{term.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* CTA */}
  <div class="container" style="text-align: center; margin-top: var(--space-4xl); margin-bottom: var(--space-4xl);">
    <h2 class="section-title animate-on-scroll">{t(locale, 'rentals.readyToBook')}</h2>
    <div class="animate-on-scroll" style="display: flex; gap: var(--space-lg); justify-content: center; flex-wrap: wrap;">
      <a href={localUrl('/contact/#rentals')} class="btn btn-primary btn-lg glow-element-intense">{t(locale, 'rentals.requestQuote')}</a>
      <a href="/assets/docs/kria-rate-card.pdf" class="btn btn-ghost btn-lg" download>{t(locale, 'rentals.downloadRateCard')}</a>
    </div>
  </div>
</Layout>

<style>
  /* Rental List - Brutal, raw */
  .rental-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
    margin-top: var(--space-2xl);
  }

  @media (min-width: 768px) {
    .rental-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1200px) {
    .rental-list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .rental-item {
    padding: var(--space-xl);
    border: 1px solid var(--border);
    background: transparent;
    transition: all var(--transition-slower);
  }

  .rental-item:hover {
    border-color: var(--accent);
    transform: translateY(-4px);
    box-shadow: var(--glow-medium);
  }

  .rental-name {
    font-size: var(--text-lg);
    margin-bottom: var(--space-sm);
  }

  .rental-specs {
    font-size: var(--text-sm);
    color: var(--fg-muted);
    margin-bottom: var(--space-md);
    line-height: 1.6;
  }

  .rental-price {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--accent);
    margin-bottom: var(--space-lg);
  }

  .rental-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    transition: gap var(--transition-fast);
  }

  .rental-link:hover {
    gap: var(--space-md);
  }

  /* Rental Grid */
  .rental-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
    margin-top: var(--space-2xl);
  }

  @media (min-width: 768px) {
    .rental-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1200px) {
    .rental-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .rental-category {
    padding: var(--space-xl);
    border: 1px solid var(--border);
    background: transparent;
    transition: all var(--transition-slower);
  }

  .rental-category:hover {
    border-color: var(--accent);
    transform: translateY(-4px);
    box-shadow: var(--glow-medium);
  }

  .category-name {
    font-size: var(--text-lg);
    margin-bottom: var(--space-md);
    color: var(--accent);
  }

  .category-items {
    font-size: var(--text-sm);
    color: var(--fg-muted);
    line-height: 1.7;
    margin-bottom: var(--space-lg);
  }

  .facility-item .rental-price {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-lg);
  }

  /* Terms Grid */
  .terms-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
    margin-top: var(--space-2xl);
  }

  @media (min-width: 768px) {
    .terms-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1200px) {
    .terms-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .term-item {
    padding: var(--space-xl);
    border: 1px solid var(--border);
    background: transparent;
    transition: all var(--transition-slower);
  }

  .term-item:hover {
    border-color: var(--accent);
    transform: translateY(-4px);
    box-shadow: var(--glow-medium);
  }

  .term-title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    color: var(--accent);
    margin-bottom: var(--space-md);
  }

  .term-desc {
    font-size: var(--text-sm);
    line-height: 1.7;
    color: var(--fg-muted);
  }
</style>
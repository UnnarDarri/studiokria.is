---
/**
 * Lightbox Component - For viewing stills/gallery images
 */
interface Props {
  images: string[];
  initialIndex?: number;
  alt?: string;
}

const { images, initialIndex = 0, alt = 'Gallery image' } = Astro.props;
---

<div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Image gallery">
  <!-- Backdrop for click-outside-to-close -->
  <div class="lightbox-backdrop" aria-hidden="true"></div>

  <!-- Constrained container that sizes to the active image -->
  <div class="lightbox-inner">
    <button class="lightbox-close" aria-label="Close lightbox">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>

    <button class="lightbox-nav lightbox-prev" aria-label="Previous image">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="15 18 9 12 15 6"/>
      </svg>
    </button>

    <button class="lightbox-nav lightbox-next" aria-label="Next image">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="9 18 15 12 9 6"/>
      </svg>
    </button>

    <div class="lightbox-content">
      {images.map((image, index) => (
        <div class={`lightbox-slide ${index === initialIndex ? 'active' : ''}`} data-index={index}>
          <img src={image} alt={`${alt} ${index + 1}`} loading="lazy" />
        </div>
      ))}
    </div>
  </div>

  <div class="lightbox-counter">
    <span class="lightbox-current">{initialIndex + 1}</span> / <span class="lightbox-total">{images.length}</span>
  </div>
</div>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: var(--z-modal);
    background: rgba(0, 0, 0, 0.95);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .lightbox.is-open {
    opacity: 1;
    visibility: visible;
  }

  /* Inner wrapper - matches image max constraints, centers in viewport */
  .lightbox-inner {
    position: relative;
    max-width: 70vw;
    max-height: 80vh;
    width: auto;
    height: auto;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Content sizes to the active slide (which is position: relative) */
  .lightbox-content {
    position: relative;
    width: 100%;
    height: 100%;
  }

  /* Slides: active is relative (gives container size), others absolute overlay */
  .lightbox-slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transform: scale(0.9);
    transition: opacity 0.3s ease, transform 0.3s ease;
    pointer-events: none;
  }

  .lightbox-slide.active {
    position: relative; /* This gives .lightbox-content its size */
    opacity: 1;
    transform: scale(1);
    pointer-events: auto;
    z-index: 1;
  }

  .lightbox-slide img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    box-shadow: 0 0 80px rgba(0, 0, 0, 0.5);
  }

  /* Backdrop - catches clicks outside content */
  .lightbox-backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: transparent;
  }

  /* Buttons positioned relative to .lightbox-inner (image constraints) */
  .lightbox-close {
    position: absolute;
    top: -32px;
    right: -32px;
    z-index: 10;
    width: 48px;
    height: 48px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    color: var(--fg);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition-base);
    backdrop-filter: blur(8px);
  }

  .lightbox-close:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg);
    transform: scale(1.1);
  }

  .lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    width: 56px;
    height: 56px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    color: var(--fg);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition-base);
    backdrop-filter: blur(8px);
    opacity: 0.7;
  }

  .lightbox-nav:hover {
    opacity: 1;
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg);
  }

  .lightbox-prev { left: -32px; }
  .lightbox-next { right: -32px; }

  @media (max-width: 768px) {
    .lightbox-inner {
      max-width: 85vw;
      max-height: 70vh;
    }
    .lightbox-close { top: -24px; right: -24px; width: 44px; height: 44px; }
    .lightbox-nav { width: 48px; height: 48px; }
    .lightbox-prev { left: -24px; }
    .lightbox-next { right: -24px; }
  }

  .lightbox-counter {
    position: fixed;
    bottom: var(--space-2xl);
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--fg);
    opacity: 0.6;
  }

  .lightbox-current { color: var(--accent); opacity: 1; }

  @media (prefers-reduced-motion: reduce) {
    .lightbox, .lightbox-slide { transition: none; }
  }
</style>

<script is:inline>
  // Lightbox state and functions - using simple object instead of class
  const LightboxState = {
    lightbox: null,
    slides: [],
    prevBtn: null,
    nextBtn: null,
    closeBtn: null,
    currentEl: null,
    totalEl: null,
    currentIndex: 0,
    total: 0,
    isAnimating: false,
    previousFocus: null,
    focusableElements: [],

    init() {
      this.lightbox = document.getElementById('lightbox');
      this.slides = this.lightbox?.querySelectorAll('.lightbox-slide') || [];
      this.prevBtn = this.lightbox?.querySelector('.lightbox-prev');
      this.nextBtn = this.lightbox?.querySelector('.lightbox-next');
      this.closeBtn = this.lightbox?.querySelector('.lightbox-close');
      this.currentEl = this.lightbox?.querySelector('.lightbox-current');
      this.totalEl = this.lightbox?.querySelector('.lightbox-total');
      this.backdropEl = this.lightbox?.querySelector('.lightbox-backdrop');
      this.currentIndex = 0;
      this.total = this.slides.length;
      this.isAnimating = false;

      if (!this.lightbox || this.total === 0) {
        console.warn('Lightbox: element not found or no slides');
        return false;
      }

      this.bindEvents();
      this.updateCounter();
      return true;
    },

    getFocusableElements() {
      if (!this.lightbox) return [];
      const selector = 'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])';
      return Array.from(this.lightbox.querySelectorAll(selector)).filter(el => {
        return el.offsetWidth > 0 && el.offsetHeight > 0 && !el.disabled && el.tabIndex !== -1;
      });
    },

    trapFocus(e) {
      if (!this.lightbox?.classList.contains('is-open')) return;
      if (e.key !== 'Tab') return;

      this.focusableElements = this.getFocusableElements();
      if (this.focusableElements.length === 0) return;

      const firstElement = this.focusableElements[0];
      const lastElement = this.focusableElements[this.focusableElements.length - 1];

      if (e.shiftKey) {
        if (document.activeElement === firstElement) {
          e.preventDefault();
          lastElement.focus();
        }
      } else {
        if (document.activeElement === lastElement) {
          e.preventDefault();
          firstElement.focus();
        }
      }
    },

    bindEvents() {
      this.prevBtn?.addEventListener('click', () => this.prev());
      this.nextBtn?.addEventListener('click', () => this.next());
      this.closeBtn?.addEventListener('click', () => this.close());

      // Close on backdrop click
      this.backdropEl?.addEventListener('click', () => this.close());

      this.lightbox?.addEventListener('click', (e) => {
        if (e.target === this.lightbox) this.close();
      });

      document.addEventListener('keydown', (e) => {
        if (!this.lightbox?.classList.contains('is-open')) return;
        if (e.key === 'Escape') this.close();
        if (e.key === 'ArrowLeft') this.prev();
        if (e.key === 'ArrowRight') this.next();
        // Focus trap
        this.trapFocus(e);
      });

      // Touch swipe support
      let touchStartX = 0;
      this.lightbox?.addEventListener('touchstart', (e) => {
        touchStartX = e.changedTouches[0].screenX;
      }, { passive: true });

      this.lightbox?.addEventListener('touchend', (e) => {
        const touchEndX = e.changedTouches[0].screenX;
        const diff = touchStartX - touchEndX;
        if (Math.abs(diff) > 50) {
          if (diff > 0) this.next();
          else this.prev();
        }
      }, { passive: true });
    },

    open(index = 0) {
      // Store previous focus for restoration
      this.previousFocus = document.activeElement;
      this.currentIndex = index;
      this.showSlide(index);
      this.lightbox?.classList.add('is-open');
      document.body.classList.add('lightbox-open');
      this.updateCounter();

      // Focus first focusable element (close button) for accessibility
      setTimeout(() => {
        this.focusableElements = this.getFocusableElements();
        this.closeBtn?.focus();
      }, 0);
    },

    close() {
      this.lightbox?.classList.remove('is-open');
      document.body.classList.remove('lightbox-open');

      // Restore focus to previously focused element
      if (this.previousFocus && typeof this.previousFocus.focus === 'function') {
        this.previousFocus.focus();
      }
    },

    prev() {
      if (this.isAnimating) return;
      const newIndex = (this.currentIndex - 1 + this.total) % this.total;
      this.showSlide(newIndex);
    },

    next() {
      if (this.isAnimating) return;
      const newIndex = (this.currentIndex + 1) % this.total;
      this.showSlide(newIndex);
    },

    showSlide(index) {
      if (this.isAnimating || index === this.currentIndex) return;

      this.isAnimating = true;
      const prevSlide = this.slides[this.currentIndex];
      const nextSlide = this.slides[index];

      prevSlide?.classList.remove('active');
      nextSlide?.classList.add('active');

      this.currentIndex = index;
      this.updateCounter();

      setTimeout(() => { this.isAnimating = false; }, 300);
    },

    updateCounter() {
      if (this.currentEl) this.currentEl.textContent = this.currentIndex + 1;
      if (this.totalEl) this.totalEl.textContent = this.total;
    }
  };

  // Initialize lightbox with retry logic
  function initLightbox() {
    // Check if already properly initialized
    if (window.lightbox && window.lightbox.lightbox) return true;

    const lightboxEl = document.getElementById('lightbox');
    if (!lightboxEl) {
      return false;
    }

    const slides = lightboxEl.querySelectorAll('.lightbox-slide');
    if (slides.length === 0) {
      return false;
    }

    // Create a fresh object with LightboxState methods
    window.lightbox = Object.create(LightboxState);
    return window.lightbox.init();
  }

  // Keep trying to initialize until successful
  function tryInit() {
    if (initLightbox()) {
      console.log('Lightbox initialized successfully');
      return;
    }
    setTimeout(tryInit, 50);
  }

  // Start trying immediately
  tryInit();

  // Also try on DOMContentLoaded as fallback
  document.addEventListener('DOMContentLoaded', tryInit, { once: true });

  // Global function to open lightbox from stills button
  window.openLightbox = function(index = 0) {
    if (!window.lightbox) {
      initLightbox();
    }
    setTimeout(() => {
      window.lightbox?.open(index);
    }, 0);
  };
</script>
---
/**
 * ProjectCard - Portfolio project card with glow effects
 * Used in portfolio grid and featured sections
 */
import GlowImage from './GlowImage.astro';
import Button from './Button.astro';

interface Props {
  project: any; // Astro content entry
  featured?: boolean;
  class?: string;
}

const { project, featured = false, class: className = '' } = Astro.props;
const { data, id } = project;

const typeLabels: Record<string, string> = {
  'short': 'Short Film',
  'feature': 'Feature Film',
  'documentary': 'Documentary',
  'commercial': 'Commercial',
  'music-video': 'Music Video',
  'series': 'Series',
  'print': 'Print Film',
};

const statusLabels: Record<string, string> = {
  'completed': 'Completed',
  'in-production': 'In Production',
  'pre-production': 'Pre-Production',
  'development': 'Development',
};

const statusColors: Record<string, string> = {
  'completed': 'var(--accent)',
  'in-production': '#e67e22',
  'pre-production': '#3498db',
  'development': '#9b59b6',
};

const projectUrl = `/projects/${id}/`;
---

<article class="project-card card {featured ? 'featured' : ''} {className}" data-status={data.status}>
  <a href={projectUrl} class="card-link-wrapper" aria-label={`View ${data.title}`}>
    <div class="card-image">
      <GlowImage
        src={data.thumbnail}
        alt={data.title}
        intensity="subtle"
        aspectRatio="16/9"
        priority={featured}
      />
      <span class="tag tag--status" style={`--status-color: ${statusColors[data.status] || 'var(--accent)'};`}>
        {statusLabels[data.status] || data.status}
      </span>
      {data.featured && <span class="tag tag--accent tag--featured">Featured</span>}
      <div class="card-hover-overlay">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <polygon points="5 3 19 12 5 21 5 3"/>
        </svg>
      </div>
    </div>
  </a>

  <div class="card-content">
    <div class="card-meta">
      <span class="tag tag--accent">{typeLabels[data.type] || data.type}</span>
      <span class="tag tag--muted">{data.year}</span>
      {data.duration && <span class="tag tag--muted">{data.duration}</span>}
    </div>

    <h3 class="card-title">
      <a href={projectUrl} class="card-title-link">{data.title}</a>
    </h3>

    <p class="card-description">{data.description}</p>

    <div class="card-footer">
      <div class="card-roles">
        {data.role.map((role: string) => (
          <span class="tag tag--muted">{role}</span>
        ))}
      </div>
      <a href={projectUrl} class="card-link btn btn-ghost btn-sm">
        View Project
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>

    {data.festival && data.festival.length > 0 && (
      <div class="card-festivals">
        {data.festival.slice(0, 3).map((fest: string) => (
          <span class="tag tag--gold">{fest}</span>
        ))}
        {data.festival.length > 3 && (
          <span class="tag tag--muted">+{data.festival.length - 3} more</span>
        )}
      </div>
    )}
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .project-card.featured {
    grid-column: span 2;
    grid-row: span 2;
  }

  @media (max-width: 900px) {
    .project-card.featured {
      grid-column: span 1;
      grid-row: span 1;
    }
  }

  .card-link-wrapper {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .card-image {
    position: relative;
    overflow: hidden;
  }

  .card-image img {
    transition: transform 1s var(--transition-spring), filter var(--transition-slow);
  }

  .project-card:hover .card-image img {
    transform: scale(1.08);
    filter: brightness(1.1) contrast(1.05);
  }

  .card-hover-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(5, 5, 5, 0.5);
    opacity: 0;
    transition: opacity var(--transition-base);
    z-index: 1;
  }

  .card-hover-overlay svg {
    color: var(--accent);
    transform: scale(0.8);
    transition: transform var(--transition-spring);
  }

  .card-link-wrapper:hover .card-hover-overlay {
    opacity: 1;
  }

  .card-link-wrapper:hover .card-hover-overlay svg {
    transform: scale(1);
  }

  .card-roles {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .card-title {
    line-height: 1.1;
    margin-bottom: var(--space-sm);
  }

  .card-title-link {
    color: inherit;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .card-title-link:hover {
    color: var(--accent);
    text-shadow: var(--glow-medium);
  }

  .card-link {
    flex-shrink: 0;
  }

  .card-festivals {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-md);
    padding-top: var(--space-md);
    border-top: 1px solid var(--border);
  }

  /* Featured badge override */
  .tag--featured {
    background: var(--accent);
    color: var(--bg);
    border-color: var(--accent);
  }
</style>
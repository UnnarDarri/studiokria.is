---
/**
 * VideoLightbox - Modal video player (YouTube embed or external link)
 * Matches Lightbox behavior: dark backdrop, close button top-right of player, no nav arrows
 */
interface Props {
  videoUrl: string;
  title: string;
  isYouTube: boolean;
  youtubeVideoId?: string;
  locale: string;
}

const { videoUrl, title, isYouTube, youtubeVideoId, locale } = Astro.props;
---

<!-- Video Lightbox Modal -->
<div class="video-lightbox" id="videoLightbox" role="dialog" aria-modal="true" aria-label={title}>
  <!-- Backdrop for click-outside-to-close -->
  <div class="video-lightbox-backdrop" aria-hidden="true"></div>

  <!-- Constrained container that sizes to the video player (matches Lightbox pattern) -->
  <div class="video-lightbox-inner">
    <button class="video-lightbox-close" aria-label="Close video player">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <div class="video-lightbox-content">
      {isYouTube && youtubeVideoId ? (
        <div class="video-lightbox-player">
          <iframe
            src={`https://www.youtube.com/embed/${youtubeVideoId}?rel=0&modestbranding=1&autoplay=0`}
            title={title}
            frameBorder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowFullScreen
            data-video-id={youtubeVideoId}
          ></iframe>
        </div>
      ) : (
        <div class="video-lightbox-external">
          <p class="video-lightbox-message">
            {locale === 'is' ? 'Opna spilara á ytri vefsíðu' : 'Open player on external site'}
          </p>
          <a href={videoUrl} class="btn btn-primary btn-lg glow-element" target="_blank" rel="noopener">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <polygon points="5 3 19 12 5 21 5 3"></polygon>
              <path d="M21 12l-6 6M21 12l-6-6"></path>
            </svg>
            {locale === 'is' ? 'Opna á RÚV' : 'Open on External Site'}
          </a>
        </div>
      )}
    </div>
  </div>
</div>

<script is:inline>
  // Video Lightbox state - matching Lightbox pattern
  const VideoLightboxState = {
    lightbox: null,
    inner: null,
    closeBtn: null,
    iframe: null,
    videoId: null,
    isOpen: false,
    previousFocus: null,
    backdropEl: null,
    focusableElements: [],

    init() {
      this.lightbox = document.getElementById('videoLightbox');
      this.inner = this.lightbox?.querySelector('.video-lightbox-inner');
      this.closeBtn = this.lightbox?.querySelector('.video-lightbox-close');
      this.iframe = this.lightbox?.querySelector('iframe');
      this.backdropEl = this.lightbox?.querySelector('.video-lightbox-backdrop');

      // Store video ID for reconstructing iframe src
      if (this.iframe) {
        this.videoId = this.iframe.dataset.videoId || null;
      }

      if (!this.lightbox) return false;

      this.bindEvents();
      return true;
    },

    getFocusableElements() {
      if (!this.lightbox) return [];
      const selector = 'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])';
      return Array.from(this.lightbox.querySelectorAll(selector)).filter(el => {
        return el.offsetWidth > 0 && el.offsetHeight > 0 && !el.disabled && el.tabIndex !== -1;
      });
    },

    trapFocus(e) {
      if (!this.isOpen) return;
      if (e.key !== 'Tab') return;

      this.focusableElements = this.getFocusableElements();
      if (this.focusableElements.length === 0) return;

      const firstElement = this.focusableElements[0];
      const lastElement = this.focusableElements[this.focusableElements.length - 1];

      if (e.shiftKey) {
        if (document.activeElement === firstElement) {
          e.preventDefault();
          lastElement.focus();
        }
      } else {
        if (document.activeElement === lastElement) {
          e.preventDefault();
          firstElement.focus();
        }
      }
    },

    bindEvents() {
      this.closeBtn?.addEventListener('click', () => this.close());
      this.backdropEl?.addEventListener('click', () => this.close());

      this.lightbox?.addEventListener('click', (e) => {
        if (e.target === this.lightbox) this.close();
      });

      document.addEventListener('keydown', (e) => {
        if (!this.isOpen) return;
        if (e.key === 'Escape') this.close();
        // Focus trap
        this.trapFocus(e);
      });
    },

    open() {
      if (!this.lightbox) return;

      this.previousFocus = document.activeElement;
      this.isOpen = true;

      // Reconstruct iframe src with autoplay=1 for reliable reload
      if (this.iframe && this.videoId) {
        this.iframe.src = `https://www.youtube.com/embed/${this.videoId}?rel=0&modestbranding=1&autoplay=1`;
      }

      this.lightbox.classList.add('is-open');
      document.body.classList.add('lightbox-open');
      document.body.style.overflow = 'hidden';

      // Focus close button for accessibility
      setTimeout(() => {
        this.focusableElements = this.getFocusableElements();
        this.closeBtn?.focus();
      }, 0);
    },

    close() {
      if (!this.lightbox) return;

      this.isOpen = false;

      // Stop video by setting iframe to about:blank
      if (this.iframe) {
        this.iframe.src = 'about:blank';
      }

      this.lightbox.classList.remove('is-open');
      document.body.classList.remove('lightbox-open');
      document.body.style.overflow = '';

      // Restore focus
      if (this.previousFocus && typeof this.previousFocus.focus === 'function') {
        this.previousFocus.focus();
      }
    }
  };

  // Initialize video lightbox with retry logic (same pattern as Lightbox)
  function initVideoLightbox() {
    // Check if already properly initialized
    if (window.videoLightbox && window.videoLightbox.lightbox) return true;

    const lightboxEl = document.getElementById('videoLightbox');
    if (!lightboxEl) {
      return false;
    }

    // Create a fresh object with VideoLightboxState methods
    window.videoLightbox = Object.create(VideoLightboxState);
    return window.videoLightbox.init();
  }

  // Keep trying to initialize until successful
  function tryInitVideoLightbox() {
    if (initVideoLightbox()) {
      console.log('VideoLightbox initialized successfully');
      return;
    }
    setTimeout(tryInitVideoLightbox, 50);
  }

  // Start trying immediately
  tryInitVideoLightbox();

  // Also try on DOMContentLoaded as fallback
  document.addEventListener('DOMContentLoaded', tryInitVideoLightbox, { once: true });

  // Global function to open video lightbox from watch film button
  window.openVideoLightbox = function() {
    if (!window.videoLightbox) {
      initVideoLightbox();
    }
    setTimeout(() => {
      window.videoLightbox?.open();
    }, 0);
  };
</script>

<style>
  /* ==========================================================================
     VIDEO LIGHTBOX - Modal video player (matches Lightbox component exactly)
     ========================================================================== */
  .video-lightbox {
    position: fixed;
    inset: 0;
    z-index: var(--z-modal);
    background: rgba(0, 0, 0, 0.95);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-xl);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .video-lightbox.is-open {
    opacity: 1;
    visibility: visible;
  }

  /* Backdrop - catches clicks outside content */
  .video-lightbox-backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: transparent;
  }

  /* Inner wrapper - almost full width for immersive video */
  .video-lightbox-inner {
    position: relative;
    max-width: 95vw;
    max-height: 95vh;
    width: auto;
    height: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1;
  }

  .video-lightbox-close {
    position: absolute;
    top: -32px;
    right: -32px;
    z-index: 10;
    width: 48px;
    height: 48px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    color: var(--fg);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition-base);
    backdrop-filter: blur(8px);
  }

  .video-lightbox-close:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg);
    transform: scale(1.1);
  }

  .video-lightbox-close:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .video-lightbox-close svg {
    width: 24px;
    height: 24px;
  }

  .video-lightbox-content {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--bg);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--glow-intense);
  }

  .video-lightbox-player {
    width: 100%;
    height: 100%;
  }

  .video-lightbox-player iframe {
    width: 100%;
    height: 100%;
    border: none;
    background: var(--bg);
  }

  .video-lightbox-external {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-lg);
    padding: var(--space-3xl);
    text-align: center;
    background: var(--bg);
  }

  .video-lightbox-message {
    font-size: var(--text-lg);
    color: var(--fg-muted);
    margin: 0;
  }

  @media (max-width: 768px) {
    .video-lightbox {
      padding: 0;
    }

    .video-lightbox-inner {
      max-width: 100vw;
      max-height: 100vh;
      width: 100%;
      height: 100%;
      /* Fill viewport - align to top for video */
      align-items: flex-start;
      justify-content: flex-start;
    }

    .video-lightbox-close {
      top: var(--space-sm);
      right: var(--space-sm);
      width: 44px;
      height: 44px;
      /* Position close button at top-right of viewport */
      position: fixed;
      z-index: 100;
    }

    .video-lightbox-content {
      width: 100%;
      max-width: 100vw;
      aspect-ratio: 16 / 9;
      border-radius: 0; /* No radius - full width */
      background: var(--bg);
    }

    .video-lightbox-external {
      padding: var(--space-xl);
    }

    .video-lightbox-message {
      font-size: var(--text-base);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .video-lightbox { transition: none; }
  }
</style>
---
/**
 * TeamCard - Team member card with portrait and role
 */
import GlowImage from './GlowImage.astro';

interface Props {
  name: string;
  role: string;
  bio: string;
  image?: string;
  email?: string;
  social?: {
    linkedin?: string;
    instagram?: string;
    twitter?: string;
  };
  class?: string;
}

const { name, role, bio, image, email, social = {}, class: className = '' } = Astro.props;
---

<article class="team-card card {className}">
  <div class="team-portrait">
    {image ? (
      <GlowImage src={image} alt={name} intensity="medium" aspectRatio="3/4" priority={true} />
    ) : (
      <div class="portrait-placeholder glow-element-medium" aria-hidden="true">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="12" cy="8" r="4"/>
          <path d="M12 14c-5 0-8 3-8 6v2h16v-2c0-3-3-6-8-6z"/>
        </svg>
      </div>
    )}
  </div>

  <div class="team-info">
    <h3 class="team-name glow-text">{name}</h3>
    <p class="team-role">{role}</p>
    <p class="team-bio">{bio}</p>

    <div class="team-contact">
      {email && (
        <a href={`mailto:${email}`} class="contact-link glow-element">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <rect x="2" y="4" width="20" height="16" rx="2"/>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
          </svg>
          <span>{email}</span>
        </a>
      )}

      <div class="team-social">
        {social.linkedin && (
          <a href={social.linkedin} class="social-link glow-element" aria-label="LinkedIn" target="_blank" rel="noopener">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
        )}
        {social.instagram && (
          <a href={social.instagram} class="social-link glow-element" aria-label="Instagram" target="_blank" rel="noopener">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
              <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
            </svg>
          </a>
        )}
        {social.twitter && (
          <a href={social.twitter} class="social-link glow-element" aria-label="Twitter" target="_blank" rel="noopener">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </a>
        )}
      </div>
    </div>
  </div>
</article>

<style>
  .team-card {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
    padding: var(--space-lg);
    text-align: center;
  }

  @media (min-width: 768px) {
    .team-card {
      grid-template-columns: 200px 1fr;
      text-align: left;
      padding: var(--space-xl);
    }
  }

  .team-portrait {
    position: relative;
    max-width: 280px;
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    .team-portrait {
      margin: 0;
    }
  }

  .portrait-placeholder {
    aspect-ratio: 3 / 4;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    color: var(--fg-subtle);
  }

  .team-name {
    margin-bottom: var(--space-xs);
  }

  .team-role {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: var(--space-md);
  }

  .team-bio {
    color: var(--fg-muted);
    line-height: 1.7;
    margin-bottom: var(--space-lg);
  }

  .team-contact {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  @media (min-width: 768px) {
    .team-contact {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    color: var(--fg-muted);
    font-size: var(--text-sm);
    transition: all var(--transition-base);
  }

  .contact-link:hover {
    border-color: var(--accent);
    color: var(--accent);
    box-shadow: var(--glow-subtle);
  }

  .team-social {
    display: flex;
    gap: var(--space-md);
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: transparent;
    border: 1px solid var(--border);
    color: var(--fg-muted);
    transition: all var(--transition-base);
  }

  .social-link:hover {
    border-color: var(--accent);
    color: var(--accent);
    box-shadow: var(--glow-subtle);
    transform: translateY(-2px);
  }
</style>